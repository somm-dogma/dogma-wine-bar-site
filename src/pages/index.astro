---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import { tastings } from "../data/tastings";
import TastingCard from "../components/TastingCard.astro";

// Hero + section photography (Design handoff)
import heroImg from "../assets/images/hero-portrait.jpg";
import placeImg from "../assets/images/moment-cheers.jpg";
import cellarBg from "../assets/images/cellar-bg.jpg";
import vasiliiPort from "../assets/images/vasilii-port.jpg";
import vasiliiPalmela from "../assets/images/vasilii-palmela.jpg";

// Moments gallery — 12 photos in Design's curated (non-sequential) order
import m01 from "../assets/images/moment-01.jpg";
import m02 from "../assets/images/moment-02.jpg";
import m03 from "../assets/images/moment-03.jpg";
import m04 from "../assets/images/moment-04.jpg";
import m05 from "../assets/images/moment-05.jpg";
import m06 from "../assets/images/moment-06.jpg";
import m07 from "../assets/images/moment-07.jpg";
import m08 from "../assets/images/moment-08.jpg";
import m09 from "../assets/images/moment-09.jpg";
import m10 from "../assets/images/moment-10.jpg";
import m11 from "../assets/images/moment-11.jpg";
import m12 from "../assets/images/moment-12.jpg";

// Credential medallions — finished PNGs, use as-is (object-fit: contain)
import credEscancoes from "../assets/images/cred-escancoes.png";
import credAsi from "../assets/images/cred-asi.png";
import credWset from "../assets/images/cred-wset.png";
import credIvv from "../assets/images/cred-ivv.png";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.contact.address}, ${site.contact.postalCode} ${site.contact.city}`
)}`;

// Recognition ledger — 5 entries. Certificate links only where the PDF exists
// in public/certificates/; the two Star Wine List entries point to the listing.
const SWL_URL =
  "https://starwinelist.com/wine-place/dogma-wine-bar?utm_source=badge&utm_content=large";
const awards = [
  {
    year: "2024",
    dist: "Top 6 · Best Newcomer, worldwide",
    src: "Star Wine List of the Year",
    link: { href: SWL_URL, label: "View on Star Wine List" },
  },
  {
    year: "2024",
    dist: "Bronze · 3rd Best Sommelier in Portugal",
    src: "XIX Concurso Nacional de Escanções",
    cert: "/certificates/bronze-sommelier-2024.pdf",
  },
  {
    year: "2024 – 26",
    dist: "Red Star · three consecutive years — first in Portugal",
    src: "Star Wine List",
    link: { href: SWL_URL, label: "View on Star Wine List" },
  },
  {
    year: "2025",
    dist: "Travellers’ Choice · Top 10% worldwide",
    src: "Tripadvisor",
    cert: "/certificates/tripadvisor-travellers-choice-2025.pdf",
  },
  {
    year: "2025 – 28",
    dist: "Official Ambassador of Porto",
    src: "Sommelier Association of Portugal",
    cert: "/certificates/ambassador-porto-2025-2028.pdf",
  },
];

const medallions = [
  { src: credEscancoes, alt: "Associação dos Escanções de Portugal — member seal" },
  { src: credAsi, alt: "ASI · Association de la Sommellerie Internationale — member seal" },
  { src: credWset, alt: "WSET — Wine & Spirit Education Trust" },
  { src: credIvv, alt: "Estabelecimento com Escanção · Sommelier" },
];

const moments = [
  { src: m02, alt: "Vasilii, Master of Port, at Dogma" },
  { src: m11, alt: "Clams, bread and small plates from above, in black and white" },
  { src: m04, alt: "A guest enjoying a glass at the colourful banquette" },
  { src: m09, alt: "Opening a bottle for guests at the banquette" },
  { src: m06, alt: "Red wine poured against the patterned banquette" },
  { src: m08, alt: "The Dogma wine bar & tasting sign at number 238" },
  { src: m12, alt: "Friends gathered for an evening of wine and food" },
  { src: m10, alt: "Pouring wine at the bar, in black and white" },
  { src: m03, alt: "Red wine poured into two glasses at the table" },
  { src: m07, alt: "A couple toasting at the outdoor table on the cobbles" },
  { src: m05, alt: "A spread of petiscos — charcuterie, cheese and crudo with wine" },
  { src: m01, alt: "The dining room full of guests under warm pendant light" },
];
---

<Base>
  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="hero">
    <figure class="hero__photo" aria-hidden="true">
      <Image
        src={heroImg}
        alt=""
        widths={[800, 1300, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner">
      <p class="hero__overline" style="--d: 200ms">
        <span class="hero__rule"></span>Wine bar &amp; tastings — Porto
      </p>
      <h1 class="hero__headline" style="--d: 320ms">
        The art of great winemakers, in a single glass.
      </h1>
      <p class="hero__subhead" style="--d: 460ms">
        A wine paradise in the historic centre of Porto, guided by the first Master of Port in
        Portugal.
      </p>
      <div class="hero__cta" style="--d: 600ms">
        <a class="btn btn--cream" href={site.booking.tasting}>Book a tasting</a>
        <a class="btn btn--ghost" href={site.booking.table} target="_blank" rel="noopener">Book a table</a>
        <a class="btn btn--ghost" href="/menu">Menu</a>
      </div>
      <p class="hero__place" style="--d: 700ms">
        Rua dos Caldeireiros 238 · 4050-139 Porto, Portugal
      </p>
    </div>

    <a class="hero__scroll" href="#place" aria-label="Scroll to content"><span></span></a>
  </section>

  <!-- ───────────────────────── THE PLACE ───────────────────────── -->
  <section class="section place" id="place">
    <div class="wrap place__inner">
      <div class="place__text" data-reveal="left">
        <p class="overline overline--ink"><span class="overline__rule"></span>The place</p>
        <h2 class="place__title">A wine paradise in the heart of Porto.</h2>
        <p class="place__body">
          Since 2023, Dogma has become one of the city’s most talked-about wine bars — a place to
          slow down, taste widely, and let the terroir speak. A long communal table, a deep cellar,
          and the conviction that great wine is best understood in good company.
        </p>
        <p class="place__stat">
          <span class="place__year">2023</span>
          <span class="place__divider" aria-hidden="true"></span>
          <span class="place__statlabel">Established in the historic centre of Porto</span>
        </p>
      </div>
      <figure class="place__media" data-reveal="right">
        <Image
          src={placeImg}
          alt="Friends toasting over a table of wine and petiscos at Dogma"
          widths={[420, 760, 1000]}
          sizes="(max-width: 860px) 100vw, 44vw"
        />
      </figure>
    </div>
  </section>

  <!-- ───────────────────── THE CREDENTIAL (dark band) ───────────────────── -->
  <section class="section credential">
    <Image
      src={cellarBg}
      alt=""
      class="credential__bg"
      aria-hidden="true"
      widths={[768, 1280, 1800]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="credential__scrim" aria-hidden="true"></div>
    <div class="wrap credential__inner">
      <figure class="credential__media" data-reveal="left">
        <Image
          src={vasiliiPort}
          alt="Vasilii Grebencea, Master of Port, holding a glass of aged Port"
          widths={[420, 720, 980]}
          sizes="(max-width: 860px) 100vw, 40vw"
        />
      </figure>
      <div class="credential__text" data-reveal="right">
        <p class="overline"><span class="overline__rule overline__rule--brass"></span>The credential</p>
        <h2 class="credential__title">The first Master of Port in Portugal.</h2>
        <p class="credential__body">
          The Master of Port is the highest distinction awarded for Port wine expertise. Vasilii
          Grebencea is the first in Portugal to hold it — and one of the country’s top three
          sommeliers. Every tasting at Dogma is led by someone who has reached the very top of his
          craft, and who pours it as a conversation rather than a lecture.
        </p>
        <a class="btn btn--cream" href={`${site.booking.tasting}?tasting=dreamy-ports`}>
          Taste with a Master of Port
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── RECOGNITION ───────────────────────── -->
  <section class="section recognition" id="recognition">
    <div class="wrap">
      <header class="recognition__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>Recognition</p>
        <h2 class="section__title">A young bar, already noticed.</h2>
      </header>

      <div class="recognition__layout">
        <ol class="awards" role="list">
          {awards.map((a) => (
            <li class="award" data-reveal>
              <span class="award__year">{a.year}</span>
              <span class="award__detail">
                <span class="award__dist">{a.dist}</span>
                <span class="award__src">{a.src}</span>
                {a.cert && (
                  <a class="award__link" href={a.cert} target="_blank" rel="noopener"
                     aria-label={`View certificate — ${a.dist}`}>View certificate →</a>
                )}
                {a.link && (
                  <a class="award__link" href={a.link.href} target="_blank" rel="noopener"
                     aria-label={`${a.link.label} — ${a.dist}`}>{a.link.label} →</a>
                )}
              </span>
            </li>
          ))}
        </ol>

        <figure class="recognition__photo" data-reveal="right">
          <div class="recognition__frame">
            <Image
              src={vasiliiPalmela}
              alt="Vasilii Grebencea assessing a glass on stage at the National Sommelier Championship"
              widths={[420, 760, 1100]}
              sizes="(max-width: 860px) 100vw, 36vw"
            />
          </div>
          <figcaption class="recognition__cap">On stage · XIX Concurso Nacional de Escanções</figcaption>
        </figure>
      </div>

      <div class="affiliations" data-reveal>
        <p class="overline overline--ink affiliations__label">Affiliations &amp; credentials</p>
        <ul class="affiliations__row" role="list">
          {medallions.map((m) => (
            <li class="medallion">
              <Image src={m.src} alt={m.alt} widths={[160, 320]} sizes="148px" loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────────────────── WE PROPOSE (the tastings) ───────────────────── -->
  <section class="section propose" id="tastings">
    <div class="wrap">
      <header class="propose__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>The tastings</p>
        <h2 class="propose__title">We propose</h2>
        <p class="propose__sub">
          From a bright Vinho Verde region to the rarest Ports — six guided flights, each crafted
          with passion and dedication.
        </p>
      </header>
      <div class="propose__grid" data-reveal>
        {tastings.map((t) => <TastingCard tasting={t} />)}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── MOMENTS ───────────────────────── -->
  <section class="section moments" id="moments">
    <div class="wrap wrap--gallery">
      <header class="moments__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>Moments</p>
        <h2 class="section__title">An evening at Dogma.</h2>
      </header>
      <div class="moments__wall">
        {moments.map((m) => (
          <figure class="mw__item">
            <Image
              src={m.src}
              alt={m.alt}
              widths={[320, 540, 760]}
              sizes="(max-width: 680px) 48vw, (max-width: 1100px) 32vw, 24vw"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

</Base>

<script>
  // Scroll reveals — IntersectionObserver, reduced-motion safe, with a
  // failsafe that reveals everything if IO never fires.
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (prefersReduced || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -7% 0px" }
    );
    items.forEach((el) => observer.observe(el));
    // failsafe
    window.setTimeout(() => items.forEach((el) => el.classList.add("is-visible")), 2800);
  }
</script>

<style>
  /* ───────── shared layout helpers ───────── */
  .wrap {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }
  .wrap--gallery { max-width: var(--container-gallery); }
  .section { padding-block: clamp(88px, 13vw, 168px); }
  .section__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin-top: 0.3em;
    text-wrap: balance;
  }

  /* Overlines — brass rule + label */
  .overline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass-mid);
  }
  .overline--ink { color: var(--brass-mid); }
  .overline--center { justify-content: center; color: var(--brass); }
  .overline__rule { width: 34px; height: 1px; background: currentColor; opacity: 0.85; }
  .overline__rule--brass { background: var(--brass); opacity: 0.9; }

  /* ───────── HERO ───────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    overflow: hidden;
    background: var(--hero-base);
    color: var(--cream-50);
    padding: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)) clamp(20px, 4vw, 40px) clamp(3.5rem, 8vw, 6rem);
  }
  .hero__photo { position: absolute; inset: 0; z-index: 0; margin: 0; }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: kenburns 7200ms var(--ease-out) both;
  }
  @keyframes kenburns {
    from { transform: scale(1.09); }
    to { transform: scale(1); }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(20, 12, 8, 0.6) 0%,
        rgba(20, 12, 8, 0.28) 28%,
        rgba(20, 12, 8, 0.42) 58%,
        rgba(20, 12, 8, 0.78) 82%,
        rgba(20, 12, 8, 0.94) 100%
      ),
      radial-gradient(120% 80% at 50% 100%, rgba(20, 12, 8, 0.5), transparent 60%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 1.7rem);
    max-width: 820px;
  }
  .hero__overline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #e8d9be;
  }
  .hero__rule { width: 38px; height: 1px; background: var(--brass); }
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, 5.8vw, 84px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: #f8f1e2;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero__subhead {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.7;
    color: #e4d8c4;
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 0.4rem;
  }
  .hero__place {
    margin-top: clamp(0.8rem, 2vw, 1.4rem);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: #f8f1e2;
  }
  /* staggered entrance */
  .hero__overline, .hero__headline, .hero__subhead, .hero__cta, .hero__place {
    opacity: 0;
    animation: heroRise 900ms var(--ease-reveal) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: none; }
  }
  .hero__scroll {
    position: absolute;
    z-index: 2;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 54px;
    background: linear-gradient(to bottom, transparent, var(--brass));
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--cream-50));
    animation: scrollPulse 2400ms ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  /* ───────── THE PLACE ───────── */
  .place { background: var(--cream); }
  .place__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  .place__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--ink);
    max-width: 16ch;
    margin: 18px 0 22px;
    text-wrap: balance;
  }
  .place__body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.78;
    color: var(--ink-soft);
    max-width: 50ch;
  }
  .place__stat {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 34px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .place__year {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 38px;
    color: var(--port-deep);
    letter-spacing: 0.02em;
  }
  .place__divider { width: 1px; height: 34px; background: var(--line); }
  .place__statlabel {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 22ch;
  }
  .place__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid rgba(58, 46, 34, 0.1);
    box-shadow: 0 26px 60px -32px rgba(42, 10, 17, 0.42);
  }
  .place__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-reveal);
  }
  .place__media:hover :global(img) { transform: scale(1.05); }

  /* ───────── THE CREDENTIAL ───────── */
  .credential {
    position: relative;
    overflow: hidden;
    background: var(--credential-bg);
    color: var(--cream-soft);
  }
  .credential__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    z-index: 0;
  }
  .credential__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      110deg,
      rgba(42, 10, 17, 0.96),
      rgba(42, 10, 17, 0.7) 55%,
      rgba(42, 10, 17, 0.92)
    );
  }
  .credential__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  .credential__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid rgba(201, 168, 106, 0.28);
    box-shadow: 0 40px 90px -42px rgba(0, 0, 0, 0.85);
  }
  .credential__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .credential__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 4.2vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: #f8f1e2;
    margin: 18px 0 22px;
    text-wrap: balance;
  }
  .credential__body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.8;
    color: var(--cream-soft);
    max-width: 52ch;
    margin-bottom: 32px;
  }

  /* ───────── RECOGNITION ───────── */
  .recognition { background: var(--cream); }
  .recognition__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .recognition__layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .awards { list-style: none; margin: 0; padding: 0; }
  .award {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 8px 0;
    padding: 26px 0;
    border-top: 1px solid rgba(40, 25, 18, 0.14);
  }
  .award:first-child { border-top: 0; padding-top: 0; }
  .award__year {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 14px;
    color: var(--port-deep);
    letter-spacing: 0.04em;
    padding-top: 4px;
  }
  .award__detail { display: flex; flex-direction: column; gap: 8px; }
  .award__dist {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 27px);
    line-height: 1.18;
    color: var(--ink);
    text-wrap: balance;
  }
  .award__src {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-mid);
  }
  .award__link {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--port-deep);
    transition: color var(--dur-fast) var(--ease-out);
