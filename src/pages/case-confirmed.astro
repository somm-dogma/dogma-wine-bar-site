---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
---

<Base
  title="Order confirmed"
  description="Your Signature Case order at Dogma Wine Bar is confirmed."
  headerSolid
  noindex
>
  <PageHeader eyebrow="Payment received" title="Your case is on its way." />

  <section class="section confirmed">
    <div class="container confirmed__inner">
      <p class="lead">
        Thank you — your payment went through. Vasilii will personally curate your selection
        and reach out within 2 business days to confirm the wines and shipping details.
      </p>
      <p class="confirmed__meta">
        Questions or changes? Reach us at
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or call
        <a href={site.contact.phoneHref}>{site.contact.phone}</a>.
      </p>
      <div class="confirmed__cta">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/signature-cases/">Order another case</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .confirmed { background: var(--cream-50); }
  .confirmed__inner { max-width: 640px; }
  .confirmed .lead { color: var(--ink); line-height: 1.75; }
  .confirmed__meta { margin-top: 1.2rem; color: var(--ink-soft); }
  .confirmed__meta a { color: var(--wine-800); border-bottom: 1px solid var(--gold-300); padding-bottom: 1px; }
  .confirmed__meta a:hover { color: var(--gold); }
  .confirmed__cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }
  .confirmed__cta .btn--ghost { color: var(--wine-800); }
</style>
