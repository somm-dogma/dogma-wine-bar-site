---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import heroImg from "../assets/images/hero-dining-room.jpg";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.contact.address}, ${site.contact.postalCode} ${site.contact.city}`
)}`;
---

<Base title="Find Us in Porto · Address, Hours & Contact" description="Find Dogma Wine Bar in the historic centre of Porto — address, hours, and how to reach us.">
  <!-- ───────────── HERO ───────────── -->
  <section class="chero">
    <Image
      src={heroImg}
      class="chero__bg"
      alt="The doorway of Dogma Wine Bar at number 238, established May 2023"
      widths={[800, 1300, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="chero__scrim" aria-hidden="true"></div>
    <div class="wrap chero__inner">
      <p class="eyebrow chero__eyebrow"><span class="chero__rule"></span>Contacts — Porto</p>
      <h1 class="chero__title">Find us in the heart of Porto.</h1>
    </div>
  </section>

  <!-- ───────────── DETAILS + MAP ───────────── -->
  <section class="section cvisit">
    <div class="wrap cvisit__grid">
      <div class="cdetails" data-reveal>
        <div class="cblock">
          <p class="eyebrow eyebrow--ink cblock__label">Where</p>
          <a class="cblock__addr" href={mapsHref} target="_blank" rel="noopener">
            {site.contact.address}<br />{site.contact.postalCode} {site.contact.city}, {site.contact.country}
          </a>
          <p class="cblock__maps">View on Google Maps →</p>
        </div>

        <div class="cblock cblock--top">
          <p class="eyebrow eyebrow--ink cblock__label">Hours</p>
          <div class="chours">
            <div class="chours__row"><span>Monday – Saturday</span><span class="chours__time">16:00 – 22:00</span></div>
            <div class="chours__row chours__row--b"><span>Sunday</span><span class="chours__closed">Closed</span></div>
          </div>
        </div>

        <div class="cblock cblock--top">
          <p class="eyebrow eyebrow--ink cblock__label">Reach us</p>
          <ul class="creach">
            <li><a href={site.contact.phoneHref}>{site.contact.phone}</a></li>
            <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
            <li><a href={site.social.instagram} target="_blank" rel="noopener">{site.social.instagramHandle}</a></li>
          </ul>
        </div>

        <div class="cblock cblock--top cblock--cta">
          <a class="btn btn--primary" href={site.booking.table} target="_blank" rel="noopener">Book a table</a>
          <a class="btn btn--ghost btn--ghost-ink" href={site.booking.tasting}>Book a tasting</a>
        </div>
      </div>

      <div class="cmap" data-reveal>
        <iframe
          title="Map — Dogma Wine Bar, Rua dos Caldeireiros 238, Porto"
          src="https://www.google.com/maps/embed?origin=mfe&pb=!1m2!2m1!1sDogma%20Wine%20Bar%2C%20Rua%20dos%20Caldeireiros%20238%2C%204050-139%20Porto"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ───────────── MESSAGE FORM (kept — Netlify) ───────────── -->
  <section class="section cform-section">
    <div class="wrap cform-wrap" data-reveal>
      <header class="cform-head">
        <p class="eyebrow eyebrow--ink"><span class="rule rule--brass"></span>Or write to us</p>
        <h2 class="cform-title">Send a message</h2>
      </header>
      <form
        class="cform"
        id="contact-form"
        name="contact"
        method="POST"
        action="/obrigado/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field" hidden>
          <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
        </p>

        <div class="form-group">
          <label for="name">Your name *</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">Email address *</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="phone">Phone (optional)</label>
          <input type="tel" id="phone" name="phone" />
        </div>
        <div class="form-group">
          <label for="subject">Subject *</label>
          <select id="subject" name="subject" required>
            <option value="">— Select a topic —</option>
            <option value="booking">Booking enquiry</option>
            <option value="event">Private event</option>
            <option value="wholesale">Wholesale/business</option>
            <option value="feedback">Feedback</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group form-group--wide">
          <label for="message">Message *</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <div class="form-consent">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">
            I have read and accept the <a href="/privacy/">Privacy Policy</a> and consent to Dogma
            storing my details to reply to this message. *
          </label>
        </div>
        <p class="cform__error" id="contact-error" role="alert" hidden></p>
        <button type="submit" class="btn btn--primary">Send message</button>
      </form>

      <div class="cform-success" id="contact-success" hidden>
        <p class="cform-success__title">Thank you — your message is on its way.</p>
        <p class="cform-success__body">
          We’ve received your message and will get back to you, usually within 24 hours. Can’t wait?
          Call us on <a href={site.contact.phoneHref}>{site.contact.phone}</a> during opening hours.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (prefersReduced || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-visible"));
  } else {
    const obs = new IntersectionObserver((entries, o) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); o.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: "0px 0px -7% 0px" });
    items.forEach((el) => obs.observe(el));
    window.setTimeout(() => items.forEach((el) => el.classList.add("is-visible")), 2800);
  }
</script>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successEl = document.getElementById("contact-success");
  const errorEl = document.getElementById("contact-error");
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorEl) { errorEl.hidden = true; errorEl.textContent = ""; }
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Sending…"; }

    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form).entries()) {
      params.append(key, String(value));
    }

    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: params.toString(),
      });
      if (!res.ok) throw new Error(`Unexpected status ${res.status}`);
      form.hidden = true;
      if (successEl) successEl.hidden = false;
    } catch {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent =
          "Something went wrong sending your message. Please call us on +351 912 925 598 or email somm@dogmawinebar.com instead.";
      }
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Send message"; }
    }
  });
</script>

<style>
  .wrap { width: 100%; max-width: var(--container-wide); margin-inline: auto; padding-inline: clamp(20px, 4vw, 40px); }
  .section { padding-block: clamp(80px, 12vw, 160px); }
  .rule { width: 34px; height: 1px; display: inline-block; }
  .rule--brass { background: var(--brass); }
  .eyebrow { display: flex; align-items: center; gap: 14px; }

  /* ── HERO ── */
  .chero { position: relative; min-height: 58vh; display: flex; align-items: flex-end; overflow: hidden; background: var(--hero-base); }
  .chero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; z-index: 0; }
  .chero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(20, 12, 8, 0.5) 0%, rgba(20, 12, 8, 0.2) 36%, rgba(20, 12, 8, 0.4) 66%, rgba(20, 12, 8, 0.9) 100%);
  }
  .chero__inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(52px, 8vh, 88px); padding-top: calc(var(--header-h) + 2rem); }
  .chero__eyebrow { color: #e8d9be; margin-bottom: 26px; }
  .chero__rule { width: 38px; height: 1px; background: var(--gold); }
  .chero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, 5.8vw, 84px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #f8f1e2;
    margin: 0;
    max-width: 16ch;
    text-wrap: balance;
  }

  /* ── DETAILS + MAP ── */
  .cvisit { background: var(--cream); }
  .cvisit__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 5vw, 80px); align-items: stretch; }
  .cdetails { display: flex; flex-direction: column; gap: clamp(36px, 4vw, 52px); }
  .cblock--top { border-top: 1px solid var(--line); padding-top: clamp(28px, 3vw, 40px); }
  .cblock__label { color: var(--brass-mid); margin-bottom: 18px; }
  .cblock__addr {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }
  .cblock__addr:hover { color: var(--port-deep); }
  .cblock__maps { font-family: var(--font-body); font-size: 14px; color: var(--port-deep); margin-top: 16px; }
  .chours__row { display: flex; justify-content: space-between; max-width: 320px; font-family: var(--font-body); font-size: 16px; color: var(--ink-soft); padding: 8px 0; }
  .chours__row--b { border-top: 1px solid rgba(40, 25, 18, 0.1); }
  .chours__time { font-family: var(--font-mono); font-size: 14px; color: var(--ink); }
  .chours__closed { font-family: var(--font-mono); font-size: 14px; color: var(--brass-mid); }
  .creach { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 13px; font-size: 16px; }
  .creach a { color: var(--ink-soft); width: fit-content; transition: color 200ms var(--ease-out); }
  .creach a:hover { color: var(--port-deep); }
  .cblock--cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .cmap {
    position: relative;
    min-height: clamp(360px, 52vw, 560px);
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid rgba(58, 46, 34, 0.14);
    box-shadow: 0 26px 60px -32px rgba(42, 10, 17, 0.42);
    background: #2a1a12;
  }
  .cmap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: saturate(0.82) brightness(0.92); }

  /* ── MESSAGE FORM ── */
  .cform-section { background: var(--cream); padding-top: 0; }
  .cform-wrap { max-width: 820px; }
  .cform-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cform-title { font-family: var(--font-display); font-weight: 500; font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); color: var(--ink); margin-top: 0.3em; }
  .cform {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .form-group { display: flex; flex-direction: column; }
  .form-group--wide, .form-consent, .cform > button, .cform__error { grid-column: 1 / -1; }
  .form-group label { font-size: var(--step--1); font-weight: 600; color: var(--wine-900); margin-bottom: 0.4rem; letter-spacing: 0.02em; }
  .form-group input, .form-group select, .form-group textarea {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--paper);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 168, 106, 0.18);
  }
  .form-group textarea { resize: vertical; font-family: var(--font-body); }
  .form-consent { display: flex; align-items: flex-start; gap: 0.6rem; }
  .form-consent input[type="checkbox"] { margin-top: 0.25rem; width: 1.05rem; height: 1.05rem; flex-shrink: 0; accent-color: var(--wine-800); cursor: pointer; }
  .form-consent label { font-size: var(--step--1); line-height: 1.5; color: var(--ink-soft); }
  .form-consent a { color: var(--wine-800); text-decoration: underline; text-underline-offset: 2px; }
  .form-consent a:hover { color: var(--port-deep); }

  .cform__error {
    margin: 0;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    background: rgba(160, 60, 60, 0.1);
    border: 1px solid #a14444;
    color: #7a2e2e;
    font-size: var(--step--1);
  }

  .cform-success {
    padding: clamp(1.6rem, 4vw, 2.6rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .cform-success__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.8rem);
    color: var(--ink);
    margin: 0 0 0.6rem;
  }
  .cform-success__body { color: var(--ink-soft); margin: 0; }
  .cform-success__body a { color: var(--wine-800); text-decoration: underline; text-underline-offset: 2px; }
  .cform-success__body a:hover { color: var(--port-deep); }

  /* reveals */
  [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 900ms var(--ease-reveal), transform 900ms var(--ease-reveal); }
  [data-reveal].is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .cvisit__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .cform { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
