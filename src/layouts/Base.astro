---
// Self-hosted fonts (latin subset) — same-origin, no Google Fonts round-trips.
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/playfair-display/latin-500.css";
import "@fontsource/playfair-display/latin-600.css";
import "@fontsource/playfair-display/latin-500-italic.css";
import "@fontsource/playfair-display/latin-600-italic.css";
// Monospace numerals — prices and figures
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { site } from "../data/site";
import { langFromPath, alternatesOf, HTML_LANG, OG_LOCALE, r } from "../i18n/routes";
import { ui } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  /** Inner pages (no dark hero) use a solid header so the nav stays readable. */
  headerSolid?: boolean;
  /** Home merges Visit + Footer into one inline section — skip the global footer. */
  bareFooter?: boolean;
  /** Utility/confirmation pages that must not be indexed by search engines. */
  noindex?: boolean;
}

const { title, description, headerSolid = false, bareFooter = false, noindex = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${t.siteTitleSuffix}`;
const pageDesc = description ?? t.siteDescription;
const canonical = new URL(Astro.url.pathname, site.url).href;
// EN ↔ PT twins for <link rel="alternate" hreflang>. Only emitted for pages
// that exist in both languages (and never on noindex utility pages).
const alternates = noindex ? undefined : alternatesOf(Astro.url.pathname);

// LocalBusiness structured data for local search (address, hours, founder).
const schema = {
  "@context": "https://schema.org",
  "@type": ["BarOrPub", "Restaurant", "LocalBusiness"],
  name: site.name,
  url: site.url,
  telephone: site.contact.phone,
  email: site.contact.email,
  priceRange: "€€",
  description: t.siteDescription,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.contact.address,
    postalCode: site.contact.postalCode,
    addressLocality: site.contact.city,
    addressCountry: "PT",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "16:00",
      closes: "22:00",
    },
  ],
  // `sameAs` is how a search engine or an AI assistant confirms that this site,
  // the TripAdvisor listing and the Star Wine List profile are all ONE business
  // rather than three similarly-named places. Entity resolution is most of what
  // decides whether a model is confident enough to recommend you by name, so
  // every real profile belongs here. .filter(Boolean) drops the blanks.
  sameAs: [
    site.social.instagram,
    site.social.tripadvisor,
    site.social.starWineList,
    site.social.googleMaps,
    site.social.facebook,
  ].filter(Boolean),
  award: site.awards,
  hasMenu: new URL(r(lang, "menu"), site.url).href,
  availableLanguage: ["English", "Portuguese"],
  acceptsReservations: site.booking.table,
  servesCuisine: ["Portuguese wine", "Port wine", "Petiscos"],
  // The single most quotable fact about this business. Modelled as a Person with
  // an explicit credential rather than a job-title string, so "Portugal's first
  // Master of Port" is machine-extractable instead of buried in prose.
  founder: {
    "@type": "Person",
    name: "Vasilii Grebencea",
    jobTitle: "Master of Port · Head Sommelier",
    worksFor: { "@type": "Organization", name: site.name, url: site.url },
    hasCredential: {
      "@type": "EducationalOccupationalCredential",
      name: "Master of Port",
      credentialCategory: "Professional certification",
      description:
        "Portugal's first Master of Port. The highest distinction in Port wine, awarded by the IVDP.",
      recognizedBy: {
        "@type": "Organization",
        name: "Instituto dos Vinhos do Douro e do Porto (IVDP)",
      },
    },
    url: new URL(r(lang, "sommelier"), site.url).href,
  },
};
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, site.url).href} />
        <link rel="alternate" hreflang="pt-PT" href={new URL(alternates.pt, site.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site.url).href} />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates && <meta property="og:locale:alternate" content={OG_LOCALE[lang === "pt" ? "en" : "pt"]} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={new URL("/og.jpg", site.url).href} />
    <meta name="theme-color" content="#3e0f18" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header solid={headerSolid} />
    <main id="main" class:list={[{ "main--padded": headerSolid }]}>
      <slot />
    </main>
    {!bareFooter && <Footer />}
    <CookieConsent />
    <style>
      .main--padded { padding-top: var(--header-h); }
    </style>
  </body>
</html>
