---
import { navKeys } from "../data/site";
import { langFromPath, alternatesOf, r, routes, type RouteKey } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { Image } from "astro:assets";
import dogmaLogo from "../assets/images/logo-medallion.jpg";

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
const currentPath = Astro.url.pathname;
const lang = langFromPath(currentPath);
const t = ui[lang];
const nav = navKeys.map((key) => ({ label: t.nav[key], href: r(lang, key as RouteKey) }));
// The switch always lands on the same page in the other language; pages
// without a twin (404) fall back to that language's home.
const twin = alternatesOf(currentPath) ?? routes.home;
const langs = [
  { code: "en", short: "en", name: "English", href: twin.en },
  { code: "pt", short: "pt", name: "Português", href: twin.pt },
] as const;
---

<header class:list={["site-header", { "is-solid": solid }]} id="site-header">
  <div class="container header-inner">
    <a class="brand" href={r(lang, "home")} aria-label={t.homeLabel}>
      <Image src={dogmaLogo} alt="Dogma — Wine Bar &amp; Tasting" class="brand__logo" widths={[120, 200, 280]} sizes="72px" loading="eager" />
    </a>

    <a class="btn btn--cream header-book" href={r(lang, "tastings")}>{t.bookShort}</a>

    <nav class="lang" aria-label={t.langSwitch}>
      {langs.map((l, i) => (
        <>
          {i > 0 && <span class="lang__sep" aria-hidden="true"></span>}
          <a
            class:list={["lang__opt", { "is-active": l.code === lang }]}
            href={l.href}
            hreflang={l.code === "pt" ? "pt-PT" : "en"}
            lang={l.code === "pt" ? "pt-PT" : "en"}
            title={l.name}
            aria-label={l.name}
            aria-current={l.code === lang ? "true" : undefined}
            data-lang={l.code}
          >{l.short}</a>
        </>
      ))}
    </nav>

    <button class="nav-toggle" aria-label={t.toggleMenu} aria-expanded="false" aria-controls="primary-nav">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="primary-nav" aria-label={t.mainNav}>
      {nav.map((item) => {
        const isActive = currentPath === item.href || (currentPath === "/" && item.href === "/");
        return (
          <a
            class:list={["nav__link", { "nav__link--active": isActive }]}
            href={item.href}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <a class="btn btn--cream nav__cta" href={r(lang, "tastings")}>{t.bookTasting}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    color: var(--cream-50);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  /* Legibility scrim while transparent over the hero */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(43, 10, 17, 0.6), rgba(43, 10, 17, 0));
    transition: opacity 0.3s ease;
  }
  .site-header.is-scrolled,
  .site-header.is-solid {
    background: var(--wine-900);
    box-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.55);
  }
  .site-header.is-scrolled::before,
  .site-header.is-solid::before {
    opacity: 0;
  }

  /* The header spans the gallery width (1440px), not the 1180px text column:
     six links + CTA + language switch need ~1230px in Portuguese. */
  .header-inner.container { max-width: var(--container-gallery); }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  /* Brand — the logo, round, on its own black. No ring, no effects.
     object-fit:cover at native scale keeps the logo's black margin, so
     the disc edge never touches the DOGMA lettering. */
  .brand {
    display: block;
    width: clamp(54px, 6.2vw, 64px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #1b1b1b;
    flex-shrink: 0;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .brand__logo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .brand:hover { transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) {
    .brand { transition: none; }
    .brand:hover { transform: none; }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.1rem);
  }
  .nav__link {
    position: relative;
    font-size: var(--step--1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0.92;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .nav__link:hover { color: var(--gold-300); opacity: 1; }
  .nav__link--active {
    color: var(--gold-300);
    opacity: 1;
  }
  .nav__link--active::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold);
    border-radius: 1px;
  }
  .nav__cta { margin-left: 0.4rem; }

  .nav-toggle { display: none; }

  /* ── Language switch — an engraved wine-label cartouche ──────────────
     Double gold hairline (border + offset outline), small-caps Playfair,
     a gold lozenge between the two languages, and a fine gold underline
     under the active one. Sits last on desktop, beside "Book" on mobile. */
  .lang {
    order: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0.7rem 0.34rem;
    border: 1px solid rgba(201, 168, 106, 0.55);
    outline: 1px solid rgba(201, 168, 106, 0.28);
    outline-offset: 2px;
    border-radius: 2px;
    font-family: var(--font-display);
    font-variant: small-caps;
    font-size: 1.02rem;
    line-height: 1;
    letter-spacing: 0.16em;
    flex-shrink: 0;
  }
  .lang__opt {
    position: relative;
    padding: 0.2rem 0 0.25rem 0.16em; /* left pad balances letter-spacing */
    color: var(--cream-soft);
    opacity: 0.72;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .lang__opt:hover { color: var(--gold-300); opacity: 1; }
  .lang__opt.is-active { color: var(--cream-50); opacity: 1; }
  .lang__opt.is-active::after {
    content: "";
    position: absolute;
    left: 18%;
    right: 10%;
    bottom: -1px;
    height: 1px;
    background: var(--gold);
  }
  .lang__opt:focus-visible { outline: 1px solid var(--gold-300); outline-offset: 3px; }
  .lang__sep {
    width: 4px;
    height: 4px;
    background: var(--gold);
    transform: rotate(45deg);
    opacity: 0.85;
  }

  /* Compact always-visible booking CTA, mobile only */
  .header-book { display: none; }

  /* Mid-width desktops: the full nav (6 links + CTA + language switch) only
     fits on one line from ~1240px — tighten its rhythm a little up to 1400. */
  @media (min-width: 1241px) and (max-width: 1400px) {
    .header-inner { gap: 1rem; }
    .nav { gap: 1.1rem; }
    .nav__link { letter-spacing: 0.1em; }
  }

  /* Compact header (logo · language · Book · menu) below 1240px. The full nav
     overflowed between 881–1239px (and wraps "Signature Cases" in English),
     more so with the longer Portuguese labels. */
  @media (max-width: 1240px) {
    .brand { order: 0; }
    .lang { order: 1; margin-left: auto; padding: 0.24rem 0.55rem 0.3rem; gap: 0.45rem; font-size: 0.98rem; }
    .header-book { order: 2; flex-shrink: 0; }
    .nav-toggle { order: 3; flex-shrink: 0; }
    .header-book {
      display: inline-flex;
      margin-left: 0.7rem;
      margin-right: 0.4rem;
      padding: 0.6em 1.2em;
      min-height: 44px;
      font-size: var(--step--1);
    }
    .nav-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 42px;
      height: 42px;
      padding: 9px;
      background: none;
      border: 0;
      color: inherit;
    }
    .nav-toggle span {
      display: block;
      height: 2px;
      width: 100%;
      background: currentColor;
      transition: transform 0.25s ease, opacity 0.25s ease;
    }
    .site-header.is-open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header.is-open .nav-toggle span:nth-child(2) { opacity: 0; }
    .site-header.is-open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--wine-900);
      box-shadow: 0 20px 30px -16px rgba(0, 0, 0, 0.5);
      transform: translateY(-10px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s;
    }
    .site-header.is-open { background: var(--wine-900); }
    .site-header.is-open .nav { transform: none; opacity: 1; visibility: visible; }
    .nav__cta { margin-left: 0; margin-top: 0.4rem; }
  }

  /* Phones: logo · EN◆PT · Reservar · ☰ must share ~335px. */
  @media (max-width: 480px) {
    .header-inner { gap: 0.55rem; }
    .header-book { margin-left: 0; margin-right: 0; padding: 0.6em 1em; letter-spacing: 0.08em; }
    .lang { padding: 0.2rem 0.45rem 0.26rem; gap: 0.38rem; font-size: 0.92rem; letter-spacing: 0.12em; }
    .nav-toggle { width: 40px; margin-right: -8px; }
  }
  @media (max-width: 350px) {
    .brand { width: 46px; }
    .header-book { padding: 0.55em 0.8em; }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    if (!header.classList.contains("is-solid")) {
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
    const toggle = header.querySelector<HTMLButtonElement>(".nav-toggle");
    toggle?.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    header.querySelectorAll(".nav__link").forEach((link) =>
      link.addEventListener("click", () => {
        header.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      })
    );
  }
</script>
