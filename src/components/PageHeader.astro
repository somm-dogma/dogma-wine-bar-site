---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow
      ? <p class="page-header__eyebrow"><span class="page-header__rule"></span>{eyebrow}</p>
      : <span class="page-header__rule page-header__rule--solo" aria-hidden="true"></span>}
    <h1 class="page-header__title">{title}</h1>
    {subtitle && <p class="page-header__sub">{subtitle}</p>}
  </div>
</section>

<style>
  .page-header {
    background: var(--wine-900);
    color: var(--cream-soft);
    padding-block: clamp(3.25rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--line-dark);
  }
  .page-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
  }
  .page-header__rule { width: 38px; height: 1px; background: var(--brass); flex-shrink: 0; }
  .page-header__rule--solo { display: block; margin-bottom: 22px; }
  .page-header__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.8rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    color: #f8f1e2;
    max-width: 18ch;
    text-wrap: balance;
  }
  .page-header__sub {
    margin-top: 1.1rem;
    max-width: 60ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--cream-soft);
  }
</style>
