---
/* GDPR / ePrivacy consent banner.
   - Decline by default: no analytics/marketing scripts load until the visitor
     opts in. Only essential storage (the consent choice itself) is used before.
   - "Accept" and "Decline" are equally weighted (GDPR: refusing must be as easy
     as accepting).
   - When consent is granted, loadAnalytics() runs — drop your GA4/gtag snippet
     there and nothing tracks until then.
   - Re-openable from the Cookie Policy page via the `dogma:open-consent` event. */
---

<div id="cookie-consent" class="cc" role="region" aria-label="Cookie consent" hidden>
  <div class="cc__inner">
    <p class="cc__text">
      We use essential cookies to make this site work. With your consent we’d also use analytics
      cookies to understand how it’s used. Read our <a href="/cookies">Cookie Policy</a>.
    </p>
    <div class="cc__actions">
      <button type="button" class="cc__btn cc__btn--accept" data-cc="accept">Accept</button>
      <button type="button" class="cc__btn cc__btn--decline" data-cc="decline">Decline</button>
    </div>
  </div>
</div>

<style>
  .cc {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 120;
    background: var(--wine-950);
    color: var(--cream-body);
    border-top: 1px solid var(--line-dark);
    box-shadow: 0 -10px 30px -16px rgba(0, 0, 0, 0.6);
    animation: cc-rise var(--dur-mid) var(--ease-out) both;
  }
  @keyframes cc-rise { from { transform: translateY(100%); } to { transform: none; } }
  .cc__inner {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.4rem) clamp(20px, 4vw, 40px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 3vw, 2.5rem);
    flex-wrap: wrap;
  }
  .cc__text { font-size: var(--step--1); line-height: 1.55; max-width: 70ch; }
  .cc__text a { color: var(--gold-300); text-decoration: underline; text-underline-offset: 3px; }
  .cc__text a:hover { color: var(--cream-50); }
  .cc__actions { display: flex; gap: 12px; flex-shrink: 0; }
  .cc__btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.8em 1.6em;
    min-height: 44px;
    border-radius: 999px;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .cc__btn--accept { background: var(--cream-50); color: var(--wine-900); border: 1px solid var(--cream-50); }
  .cc__btn--accept:hover { background: #fff; border-color: #fff; }
  .cc__btn--decline { background: transparent; color: var(--cream-body); border: 1px solid var(--line-dark); }
  .cc__btn--decline:hover { background: rgba(247, 240, 225, 0.1); border-color: var(--brass); }
  @media (max-width: 600px) {
    .cc__actions { width: 100%; }
    .cc__btn { flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .cc { animation: none; } }
</style>

<script>
  const KEY = "dogma-consent";
  const el = document.getElementById("cookie-consent");

  function loadAnalytics() {
    // Consent granted for analytics. Add your GA4 / gtag snippet here — it will
    // only ever run after the visitor accepts. Nothing tracks before this.
    // Example:
    //   const s = document.createElement("script");
    //   s.src = "https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX";
    //   s.async = true; document.head.appendChild(s);
    //   window.dataLayer = window.dataLayer || [];
    //   function gtag(){ dataLayer.push(arguments); }
    //   gtag("js", new Date()); gtag("config", "G-XXXXXXX");
  }

  function decide(value: "granted" | "denied") {
    try { localStorage.setItem(KEY, JSON.stringify({ value, at: Date.now() })); } catch {}
    if (el) el.hidden = true;
    if (value === "granted") loadAnalytics();
  }

  if (el) {
    let stored: string | null = null;
    try { stored = localStorage.getItem(KEY); } catch {}
    if (!stored) {
      el.hidden = false;
    } else {
      try { if (JSON.parse(stored).value === "granted") loadAnalytics(); } catch { el.hidden = false; }
    }
    el.querySelector('[data-cc="accept"]')?.addEventListener("click", () => decide("granted"));
    el.querySelector('[data-cc="decline"]')?.addEventListener("click", () => decide("denied"));
    // Let the Cookie Policy page re-open the banner to change preferences
    window.addEventListener("dogma:open-consent", () => {
      try { localStorage.removeItem(KEY); } catch {}
      el.hidden = false;
      el.scrollIntoView({ behavior: "smooth", block: "end" });
    });
  }
</script>
