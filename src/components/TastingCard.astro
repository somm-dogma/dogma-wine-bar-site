---
/* Shared tasting card — Option A "editorial card" from the Design handoff.
   Reused on Home ("We propose") and /bookatasting. The whole card is a link
   to /bookatasting?tasting=<slug>; on the booking page a small script
   intercepts it to preselect the on-page form (see bookatasting.astro). */
import { Image } from "astro:assets";
import { localizeTasting, type Tasting } from "../data/tastings";
import { langFromPath, r } from "../i18n/routes";
import { ui, euro } from "../i18n/ui";

interface Props {
  tasting: Tasting;
  /** Emit id={slug} so #slug deep-links land on this card (booking page). */
  anchor?: boolean;
}
const { tasting, anchor = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = ui[lang].card;
const { slug, name, description, includes, price, duration, fixedTime, image, alt } = localizeTasting(tasting, lang);
// PT writes times as "16h30"; EN keeps "16:30".
const when = fixedTime
  ? t.schedule.replace("{t}", lang === "pt" ? fixedTime.replace(":", "h") : fixedTime)
  : t.private;
---

<a
  class="tcard"
  href={`${r(lang, "tastings")}?tasting=${slug}`}
  id={anchor ? slug : undefined}
  data-tasting={slug}
>
  <span class="tcard__media">
    <Image
      src={image}
      alt={alt}
      widths={[400, 700, 900]}
      sizes="(max-width: 620px) 100vw, (max-width: 980px) 50vw, 33vw"
      loading="lazy"
    />
  </span>
  <h3 class="tcard__name">{name}</h3>
  <span class="tcard__desc">{description}</span>
  <span class="tcard__includes">{includes}</span>
  <span class="tcard__foot">
    <span class="tcard__meta">
      <span class="tcard__price-wrap">
        <span class="tcard__price">{euro(lang, price)}</span>
        <span class="tcard__pp">{t.perPerson}</span>
      </span>
      <span class="tcard__when">
        <span>{when}</span>
        <span>{duration}</span>
      </span>
    </span>
    <span class="tcard__reserve">{t.reserve}<span class="tcard__arrow" aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  /* Editorial card. Rows sit on a shared subgrid so names, descriptions,
     "includes" lines and footers align across every card in a row. */
  .tcard {
    --pad: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-mid) var(--ease-out);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .tcard:hover { border-color: rgba(36, 19, 23, 0.32); }
  .tcard:focus-visible { outline: 2px solid var(--wine-700); outline-offset: 3px; }

  .tcard__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--wine-900);
  }
  .tcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .tcard:hover .tcard__media :global(img) { transform: scale(1.04); }

  .tcard__name {
    padding: calc(var(--pad) * 1.05) var(--pad) 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--wine-900);
    text-wrap: balance;
  }
  .tcard__desc {
    padding: 0.85rem var(--pad) 0;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .tcard__includes {
    align-self: start;
    margin: 1.25rem var(--pad) 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink);
  }

  .tcard__foot { display: flex; flex-direction: column; margin-top: 1.1rem; }
  .tcard__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 var(--pad) 1.25rem;
  }
  .tcard__price-wrap { display: flex; flex-direction: column; gap: 0.15rem; }
  .tcard__price {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--wine-900);
  }
  .tcard__pp { font-size: var(--step--1); color: var(--ink-soft); }
  .tcard__when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    padding-top: 0.2rem;
    white-space: nowrap;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    color: var(--ink-soft);
    text-align: right;
  }
  .tcard__when > :first-child { color: var(--wine-800); font-weight: 600; }

  .tcard__reserve {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem var(--pad);
    border-top: 1px solid var(--line);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wine-800);
    transition: background var(--dur-mid) var(--ease-out), color var(--dur-mid) var(--ease-out);
  }
  .tcard__arrow {
    font-size: 1.15em;
    letter-spacing: 0;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .tcard:hover .tcard__reserve { background: var(--wine-800); color: var(--cream-50); }
  .tcard:hover .tcard__arrow { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .tcard, .tcard__media :global(img), .tcard__reserve, .tcard__arrow { transition: none; }
    .tcard:hover .tcard__media :global(img), .tcard:hover .tcard__arrow { transform: none; }
  }
</style>
