---
/* Shared footer — the merged "Visit" + contact block used on every page
   (the Home page uses this same component, no separate inline footer). */
import { site } from "../data/site";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.contact.address}, ${site.contact.postalCode} ${site.contact.city}`
)}`;
---

<footer class="visit">
  <div class="wrap visit__inner">
    <div class="visit__lead">
      <p class="overline overline--center"><span class="rule"></span>Visit<span class="rule"></span></p>
      <h2 class="visit__title">Pull up a seat.</h2>
      <p class="visit__tag">A place where the art of great winemakers fills glasses.</p>
      <div class="visit__cta">
        <a class="btn btn--cream" href={site.booking.table} target="_blank" rel="noopener">Book a table</a>
        <a class="btn btn--ghost" href={site.booking.tasting}>Book a tasting</a>
        <a class="btn btn--ghost" href="/menu">Menu</a>
      </div>
    </div>

    <div class="visit__grid">
      <div class="visit__col">
        <h3 class="visit__h">Services</h3>
        <ul class="visit__list">
          <li><a href="/menu">Menu</a></li>
          <li><a href={site.booking.tasting}>Degustation</a></li>
          <li><a href="/signature-cases">Wine Boxes</a></li>
        </ul>
      </div>
      <div class="visit__col">
        <h3 class="visit__h">Contacts</h3>
        <ul class="visit__list">
          <li>
            <a href={mapsHref} target="_blank" rel="noopener">
              {site.contact.address}, {site.contact.postalCode} {site.contact.city}
            </a>
          </li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener">{site.social.instagramHandle}</a></li>
        </ul>
      </div>
      <div class="visit__col">
        <h3 class="visit__h">Company</h3>
        <ul class="visit__list">
          <li><a href="/#place">About</a></li>
          <li><a href="/sommelier">Sommelier</a></li>
        </ul>
      </div>
    </div>

    <div class="visit__bottom">
      <p class="visit__copy">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <a class="visit__privacy" href="/privacy">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .visit {
    background: var(--visit-bg);
    color: var(--cream-body);
    padding: clamp(88px, 12vw, 150px) 0 44px;
  }
  .wrap { width: 100%; max-width: var(--container-wide); margin-inline: auto; padding-inline: clamp(20px, 4vw, 40px); }

  .overline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .overline--center { justify-content: center; }
  .rule { width: 34px; height: 1px; background: var(--brass); opacity: 0.9; }

  .visit__lead { text-align: center; max-width: 640px; margin-inline: auto; }
  .visit__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.06;
    letter-spacing: -0.012em;
    color: #f8f1e2;
    margin: 16px 0 14px;
  }
  .visit__tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.8vw, 20px);
    color: var(--cream-soft);
  }
  .visit__cta { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 30px; }
  .visit__cta .btn--ghost { color: var(--cream-50); }

  .visit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    margin-top: clamp(56px, 9vw, 96px);
    padding-top: clamp(40px, 5vw, 56px);
    border-top: 1px solid var(--line-dark);
  }
  .visit__h {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 14px;
  }
  .visit__col p, .visit__col a { color: var(--cream-body); line-height: 1.7; }
  .visit__col a { transition: color var(--dur-fast) var(--ease-out); }
  .visit__col a:hover { color: #f8f1e2; }
  .visit__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }

  .visit__bottom {
    margin-top: clamp(56px, 9vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line-dark);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--step--1);
    color: var(--cream-soft);
  }
  .visit__copy { margin: 0; }
  .visit__privacy { color: var(--cream-soft); transition: color var(--dur-fast) var(--ease-out); }
  .visit__privacy:hover { color: #f8f1e2; }

  @media (max-width: 760px) {
    .visit__grid { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .visit__bottom { justify-content: center; text-align: center; }
  }
</style>
