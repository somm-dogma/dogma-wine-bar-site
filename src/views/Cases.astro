---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import { CASE_CATEGORIES, BOTTLE_SIZES, localizeCase } from "../data/cases";
import { COUNTRIES } from "../data/shipping";
import { langFromPath, r } from "../i18n/routes";
import { euro } from "../i18n/ui";
import cellarBg from "../assets/images/cellar-bg.jpg";

const lang = langFromPath(Astro.url.pathname);
const lowestPricePerBottle = Math.min(...CASE_CATEGORIES.map((c) => c.pricePerBottle));
const categories = CASE_CATEGORIES.map((c) => localizeCase(c, lang));

// Country names in the page language, from the ISO code (Intl ships the
// official pt-PT names: "Reino Unido", "Países Baixos"…). Portugal stays
// first; the rest are sorted alphabetically for that language.
const regionNames = new Intl.DisplayNames([lang === "pt" ? "pt-PT" : "en"], { type: "region" });
const countries = (() => {
  if (lang === "en") return COUNTRIES;
  const named = COUNTRIES.map((c) => ({ code: c.code, name: regionNames.of(c.code) ?? c.name }));
  const [first, ...rest] = named;
  return [first, ...rest.sort((a, b) => a.name.localeCompare(b.name, "pt"))];
})();

const T = {
  en: {
    title: "Signature Cases · Wine Shipped Worldwide",
    description: `Cases of Portuguese wine hand-picked by Portugal's first Master of Port, shipped worldwide with duties included. From €${lowestPricePerBottle} a bottle.`,
    heading: "Portugal in a case.",
    sub: "A personal selection of exceptional wines, curated by Vasilii Grebencea — Portugal's first Master of Port — and shipped to your door anywhere in the world.",
    steps: [
      { h: "Choose your tier", p: "Three quality levels, each a fixed price per bottle. The sommelier decides which bottles go in — that's the whole point." },
      { h: "Tell us what you want", p: "From 6 to 48 bottles in steps of 6. Leave a note about a wine you loved at Dogma, a style, an occasion — Vasilii reads every message." },
      { h: "We curate & ship", p: "Pay now. Vasilii personally selects the wines and arranges international shipping via IberoMail. Expect contact within 2 business days." },
    ],
    tiersOver: "The tiers", tiersTitle: "Choose your quality level", tierAria: "Wine tier", tier: "Tier",
    discTag: "For Dogma guests", discTitle: "Loved a wine during your tasting?",
    discBody: "You can have it. Tell us the name, the producer, or just describe the moment — Vasilii will track it down and include it in your case. One bottle, a dozen, or the whole case built around that wine. The comment field in the order form is there for exactly this.",
    build: "Build your case",
    orderTitle: "Configure your case",
    canceled: "Your payment was cancelled — nothing was charged. Adjust your order and try again.",
    bottles: "Number of bottles", bottleAria: "Bottle count",
    country: "Delivery country", selectCountry: "— Select country —",
    wines: "Wines", shipping: "International shipping", total: "Total",
    consultStrong: "Shipping under consultation",
    consultText: "this combination of destination and quantity is not covered by our standard rates. Contact us for a custom quote.",
    quote: "Request a quote by email",
    details: "Your details", fullName: "Full name", email: "Email", phone: "Phone",
    comment: "Comment / Special wish",
    placeholder: "Loved a wine at Dogma? Tell us — name, producer, or just how it tasted. Also: a gift, an occasion, a style preference, a dietary note. Vasilii reads every message.",
    honeypot: "Leave this empty",
    consentA: "I have read and accept the", privacy: "Privacy Policy", consentB: "and consent to Dogma storing my details to manage this order.",
    customs: "All customs duties and import fees are included in the shipping price via IberoMail. No surprise charges on delivery.",
    pay: "Pay & confirm",
    faqTitle: "Questions about Signature Cases",
    faq: [
      { q: "Can I request a wine I tasted at Dogma?", a: "Absolutely — that's one of the best uses of this service. Use the comment field to tell us the wine, the producer, or just what it tasted like and roughly when you visited. Vasilii will track it down and include it in your case. You can request a single bottle, several, or have the whole case built around it. Style preferences, occasions, dietary restrictions — anything goes in that field." },
      { q: "When will my case be shipped?", a: "Vasilii will contact you within 2 business days of your order to confirm the selection. Delivery times vary depending on destination — he'll give you a realistic estimate when he gets in touch." },
      { q: "Are import duties and taxes included?", a: "Yes — all customs duties and import fees are covered through IberoMail. The price you see at checkout is the price you pay, with no surprise charges on delivery." },
      { q: "My country isn't available or shows \"shipping under consultation\" — what does that mean?", a: "Some destinations or larger orders require a custom shipping quote outside our standard IberoMail rates. Email us at __EMAIL__ — we'll check what's possible and come back to you within 48 hours." },
      { q: "Can I order more than 48 bottles?", a: "Yes — contact us directly and we'll arrange a custom quote for larger quantities." },
      { q: "What's the refund policy?", a: "Once the wines have been selected and packed, we cannot accept returns on wine for reasons of quality. If there is a problem with your delivery — damaged bottles or a shipping issue — contact us immediately and we'll make it right." },
    ],
    js: {
      wines: "Wines", bottles: "bottles", to: "to", consult: "On request",
      quoteSubject: "Signature Cases shipping quote",
      needName: "Please enter your full name.",
      needEmail: "Please enter a valid email address.",
      needPhone: "Please enter a valid phone number.",
      needConsent: "Please accept the Privacy Policy to continue.",
      redirecting: "Redirecting to secure payment…",
      pay: "Pay & confirm",
      couldNotPay: "Could not start checkout. Please try again.",
      network: "Network error. Please try again.",
      tooMany: "Too many requests — please wait a moment and try again.",
      checkForm: "Please check the form and try again.",
      consultation: "This shipping destination requires a custom quote. Please contact us directly.",
    },
  },
  pt: {
    title: "Caixas de Vinho · Envio para Todo o Mundo",
    description: `Caixas de vinho português escolhidas pelo primeiro Master of Port de Portugal, com envio para todo o mundo e taxas incluídas. Desde ${lowestPricePerBottle} € a garrafa.`,
    heading: "Portugal numa caixa.",
    sub: "Uma seleção pessoal de vinhos excecionais, escolhida por Vasilii Grebencea — o primeiro Master of Port de Portugal — e enviada para a sua porta, em qualquer parte do mundo.",
    steps: [
      { h: "Escolha o nível", p: "Três níveis de qualidade, cada um com um preço fixo por garrafa. É o escanção quem decide as garrafas — é essa a ideia." },
      { h: "Diga-nos o que procura", p: "De 6 a 48 garrafas, em múltiplos de 6. Deixe uma nota sobre um vinho de que gostou no Dogma, um estilo, uma ocasião — o Vasilii lê todas as mensagens." },
      { h: "Nós escolhemos e enviamos", p: "Pague agora. O Vasilii escolhe pessoalmente os vinhos e trata do envio internacional pela IberoMail. Entraremos em contacto no prazo de 2 dias úteis." },
    ],
    tiersOver: "Os níveis", tiersTitle: "Escolha o nível de qualidade", tierAria: "Nível do vinho", tier: "Nível",
    discTag: "Para clientes do Dogma", discTitle: "Gostou de um vinho na sua prova?",
    discBody: "Pode tê-lo em casa. Diga-nos o nome, o produtor ou simplesmente descreva o momento — o Vasilii encontra-o e inclui-o na sua caixa. Uma garrafa, uma dúzia ou a caixa inteira construída à volta desse vinho. O campo de comentário da encomenda existe precisamente para isso.",
    build: "Montar a sua caixa",
    orderTitle: "Configure a sua caixa",
    canceled: "O pagamento foi cancelado — nada foi cobrado. Ajuste a encomenda e tente novamente.",
    bottles: "Número de garrafas", bottleAria: "Número de garrafas",
    country: "País de entrega", selectCountry: "— Escolha o país —",
    wines: "Vinhos", shipping: "Envio internacional", total: "Total",
    consultStrong: "Envio sob consulta",
    consultText: "esta combinação de destino e quantidade não está coberta pelas nossas tarifas habituais. Contacte-nos para um orçamento à medida.",
    quote: "Pedir orçamento por email",
    details: "Os seus dados", fullName: "Nome completo", email: "Email", phone: "Telemóvel",
    comment: "Comentário / pedido especial",
    placeholder: "Gostou de um vinho no Dogma? Diga-nos — o nome, o produtor ou só como era. E ainda: uma oferta, uma ocasião, um estilo preferido, uma restrição alimentar. O Vasilii lê todas as mensagens.",
    honeypot: "Deixe este campo vazio",
    consentA: "Li e aceito a", privacy: "Política de Privacidade", consentB: "e autorizo o Dogma a guardar os meus dados para gerir esta encomenda.",
    customs: "Todos os direitos aduaneiros e taxas de importação estão incluídos no preço do envio, através da IberoMail. Sem surpresas na entrega.",
    pay: "Pagar e confirmar",
    faqTitle: "Perguntas sobre as Signature Cases",
    faq: [
      { q: "Posso pedir um vinho que provei no Dogma?", a: "Com certeza — é uma das melhores formas de usar este serviço. Use o campo de comentário para nos dizer o vinho, o produtor ou apenas como era e, aproximadamente, quando nos visitou. O Vasilii encontra-o e inclui-o na sua caixa. Pode pedir uma só garrafa, várias ou a caixa inteira construída à volta desse vinho. Preferências de estilo, ocasiões, restrições alimentares — tudo cabe nesse campo." },
      { q: "Quando é enviada a minha caixa?", a: "O Vasilii entra em contacto consigo no prazo de 2 dias úteis após a encomenda para confirmar a seleção. Os prazos de entrega variam consoante o destino — ele dá-lhe uma estimativa realista nesse contacto." },
      { q: "Os direitos de importação e as taxas estão incluídos?", a: "Sim — todos os direitos aduaneiros e taxas de importação estão cobertos através da IberoMail. O preço que vê no pagamento é o preço que paga, sem surpresas na entrega." },
      { q: "O meu país não aparece ou indica \"envio sob consulta\" — o que significa?", a: "Alguns destinos ou encomendas maiores exigem um orçamento de envio à medida, fora das tarifas habituais da IberoMail. Escreva-nos para __EMAIL__ — vemos o que é possível e respondemos no prazo de 48 horas." },
      { q: "Posso encomendar mais de 48 garrafas?", a: "Sim — contacte-nos diretamente e preparamos um orçamento à medida para quantidades maiores." },
      { q: "Qual é a política de reembolso?", a: "Depois de os vinhos serem escolhidos e embalados, não podemos aceitar devoluções de vinho, por razões de qualidade. Se houver algum problema com a entrega — garrafas danificadas ou um incidente no envio — contacte-nos de imediato e resolvemos a situação." },
    ],
    js: {
      wines: "Vinhos", bottles: "garrafas", to: "para", consult: "Sob consulta",
      quoteSubject: "Orçamento de envio Signature Cases",
      needName: "Indique o seu nome completo.",
      needEmail: "Indique um endereço de email válido.",
      needPhone: "Indique um número de telefone válido.",
      needConsent: "Aceite a Política de Privacidade para continuar.",
      redirecting: "A redirecionar para o pagamento seguro…",
      pay: "Pagar e confirmar",
      couldNotPay: "Não foi possível iniciar o pagamento. Tente novamente.",
      network: "Erro de ligação. Tente novamente.",
      tooMany: "Demasiados pedidos — aguarde um momento e tente novamente.",
      checkForm: "Verifique os dados do formulário e tente novamente.",
      consultation: "Este destino exige um orçamento de envio à medida. Contacte-nos diretamente, por favor.",
    },
  },
};
const t = T[lang];
const emailLink = `<a href="mailto:${site.contact.email}">${site.contact.email}</a>`;
const faq = t.faq.map((f) => ({ ...f, a: f.a.replace("__EMAIL__", emailLink) }));
const quoteHref = `mailto:${site.contact.email}?subject=${encodeURIComponent(t.js.quoteSubject)}`;
---

<Base title={t.title} description={t.description} headerSolid>
  <!-- ──────────────────── Hero ──────────────────── -->
  <section class="chero">
    <Image
      src={cellarBg}
      class="chero__bg"
      alt=""
      aria-hidden="true"
      widths={[768, 1280, 1800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="chero__scrim" aria-hidden="true"></div>
    <div class="container chero__inner">
      <p class="eyebrow"><span class="chero__rule"></span>Signature Cases</p>
      <h1 class="chero__title">{t.heading}</h1>
      <p class="chero__sub">{t.sub}</p>
    </div>
  </section>

  <!-- ──────────────────── How it works ──────────────────── -->
  <section class="section howit">
    <div class="container howit__inner">
      {t.steps.map((st, i) => (
        <div class="howit-step">
          <span class="howit-step__num">{`0${i + 1}`}</span>
          <h3 class="howit-step__title">{st.h}</h3>
          <p class="howit-step__body">{st.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ──────────────────── Category cards ──────────────────── -->
  <section class="section cats" id="configure">
    <div class="container">
      <header class="cats__head">
        <p class="eyebrow eyebrow--ink"><span class="rule rule--brass"></span>{t.tiersOver}</p>
        <h2 class="cats__title">{t.tiersTitle}</h2>
      </header>

      <div class="cat-grid" role="radiogroup" aria-label={t.tierAria}>
        {categories.map((cat, i) => (
          <button
            class="cat-card"
            type="button"
            role="radio"
            aria-checked={i === 0 ? "true" : "false"}
            data-slug={cat.slug}
            data-price={cat.pricePerBottle}
            data-name={cat.name}
          >
            <span class="cat-card__tier">{t.tier} {["I","II","III"][i]}</span>
            <p class="cat-card__price">{cat.tagline}</p>
            <h3 class="cat-card__name">{cat.name}</h3>
            <p class="cat-card__desc">{cat.description}</p>
            <span class="cat-card__check" aria-hidden="true">✓</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ──────────────────── Discovery callout ──────────────────── -->
  <section class="section discovery">
    <div class="container discovery__inner">
      <p class="discovery__tag">{t.discTag}</p>
      <h2 class="discovery__title">{t.discTitle}</h2>
      <p class="discovery__body">{t.discBody}</p>
      <a class="btn btn--cream" href="#order">{t.build}</a>
    </div>
  </section>

  <!-- ──────────────────── Order form ──────────────────── -->
  <section class="section order-section">
    <div class="container">
      <div class="order" id="order" data-lang={lang} data-i18n={JSON.stringify(t.js)}>
        <h2 class="order__title">{t.orderTitle}</h2>

        {/* Cancelled-payment notice */}
        <p class="order__alert" id="canceled-note" hidden>{t.canceled}</p>

        <!-- Bottle count -->
        <div class="order__group">
          <p class="order__label">{t.bottles}</p>
          <div class="bottle-chips" role="group" aria-label={t.bottleAria}>
            {BOTTLE_SIZES.map((n, i) => (
              <button
                class="bottle-chip"
                type="button"
                aria-pressed={i === 1 ? "true" : "false"}
                data-n={n}
              >
                {n}
              </button>
            ))}
          </div>
        </div>

        <!-- Country -->
        <div class="order__group">
          <div class="field">
            <label for="countryCode">{t.country}</label>
            <select id="countryCode">
              <option value="">{t.selectCountry}</option>
              {countries.map((c) => (
                <option value={c.code}>{c.name}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Price summary -->
        <div class="price-summary" id="price-summary">
          <div class="price-row">
            <span id="wine-label">{t.wines}</span>
            <span class="price-val" id="wine-price">—</span>
          </div>
          <div class="price-row">
            <span>{t.shipping}</span>
            <span class="price-val" id="shipping-price">—</span>
          </div>
          <div class="price-row price-row--total">
            <span>{t.total}</span>
            <span class="price-val" id="grand-total">—</span>
          </div>
        </div>

        <!-- Consultation banner -->
        <div class="consult-banner" id="consult-banner" hidden>
          <p class="consult-banner__text">
            <strong>{t.consultStrong}</strong> — {t.consultText}
          </p>
          <a class="btn btn--ghost consult-banner__btn" id="consult-link" href={quoteHref}>
            {t.quote}
          </a>
        </div>

        <!-- Contact details (shown when a valid shipping price exists) -->
        <div class="contact-step" id="contact-step" hidden>
          <h3 class="contact-step__title">{t.details}</h3>
          <div class="booking__grid">
            <div class="field field--wide">
              <label for="name">{t.fullName}</label>
              <input type="text" id="name" autocomplete="name" maxlength="120" />
            </div>
            <div class="field">
              <label for="email">{t.email}</label>
              <input type="email" id="email" autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">{t.phone}</label>
              <input type="tel" id="phone" autocomplete="tel" />
            </div>
          </div>

          <div class="field field--comment">
            <label for="comment">{t.comment}</label>
            <textarea id="comment" rows="3" maxlength="500" placeholder={t.placeholder}></textarea>
          </div>

          <!-- Honeypot -->
          <div class="hp" aria-hidden="true">
            <label>{t.honeypot}<input type="text" id="botField" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="consent">
            <input type="checkbox" id="consent" />
            <span>
              {t.consentA} <a href={r(lang, "privacy")}>{t.privacy}</a> {t.consentB}
            </span>
          </label>

          <p class="customs-notice customs-notice--ok">{t.customs}</p>

          <button class="btn btn--primary" type="button" id="pay-btn">
            <span id="pay-label">{t.pay}</span>
          </button>
          <p class="booking__error" id="form-error" role="alert" hidden></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────── FAQ ──────────────────── -->
  <section class="section cases-faq">
    <div class="container cases-faq__inner">
      <h2 class="cases-faq__title">{t.faqTitle}</h2>
      {faq.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p set:html={f.a} />
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* ──────── Hero ──────── */
  .chero {
    position: relative;
    overflow: hidden;
    background: var(--credential-bg);
    color: var(--cream-soft);
    padding: calc(var(--header-h) + clamp(3rem, 8vw, 6rem)) 0 clamp(3rem, 8vw, 6rem);
  }
  .chero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 35%;
    opacity: 0.22; z-index: 0;
  }
  .chero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(120deg, rgba(42,10,17,0.94), rgba(42,10,17,0.72) 60%, rgba(42,10,17,0.90));
  }
  .chero__inner { position: relative; z-index: 2; max-width: 56ch; }
  .chero .eyebrow { display: flex; align-items: center; gap: 14px; }
  .chero__rule { width: 34px; height: 1px; background: var(--brass); }
  .chero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 1.9rem + 3.4vw, 4.4rem);
    line-height: 1.04; letter-spacing: -0.015em;
    color: #f8f1e2; margin: 14px 0 18px;
  }
  .chero__sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.5; color: var(--cream-soft);
  }

  /* ──────── How it works ──────── */
  .howit { background: var(--wine-900); color: var(--cream-soft); }
  .howit__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }
  .howit-step { padding-top: 1.4rem; border-top: 1px solid rgba(196,149,42,0.3); }
  .howit-step__num {
    font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--gold-300); letter-spacing: 0.08em;
  }
  .howit-step__title {
    font-family: var(--font-display); font-weight: 500;
    font-size: var(--step-1); color: #f8f1e2;
    margin: 0.6rem 0 0.5rem;
  }
  .howit-step__body { font-size: var(--step--1); line-height: 1.65; color: var(--cream-soft); opacity: 0.82; }
  @media (max-width: 760px) { .howit__inner { grid-template-columns: 1fr; } }

  /* ──────── Category section ──────── */
  .cats { background: var(--cream); }
  .cats__head { margin-bottom: clamp(2rem, 4vw, 2.8rem); }
  .cats__head .eyebrow { display: flex; align-items: center; gap: 14px; }
  .rule { width: 34px; height: 1px; display: inline-block; }
  .rule--brass { background: var(--brass); }
  .cats__title {
    font-family: var(--font-display); font-weight: 500;
    font-size: var(--step-2); color: var(--ink); margin-top: 0.3em;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
  }
  @media (max-width: 900px) { .cat-grid { grid-template-columns: 1fr; max-width: 480px; } }

  .cat-card {
    position: relative;
    display: flex; flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-card);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
  }
  .cat-card:hover {
    border-color: var(--gold-300);
    box-shadow: 0 8px 28px -10px rgba(62,15,24,0.2);
    transform: translateY(-2px);
  }
  .cat-card[aria-checked="true"] {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(196,149,42,0.18), 0 10px 32px -12px rgba(62,15,24,0.25);
  }
  .cat-card__tier {
    font-family: var(--font-mono); font-size: var(--step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 0.5rem;
  }
  .cat-card__price {
    font-family: var(--font-mono); font-size: var(--step-0);
    color: var(--wine-800); font-weight: 600; margin-bottom: 0.6rem;
  }
  .cat-card__name {
    font-family: var(--font-display); font-weight: 500;
    font-size: var(--step-1); color: var(--wine-900);
    line-height: 1.2; margin-bottom: 0.7rem;
  }
  .cat-card__desc {
    font-size: var(--step--1); color: var(--ink-soft);
    line-height: 1.6; flex: 1;
  }
  .cat-card__check {
    position: absolute; top: 1rem; right: 1rem;
    width: 1.5rem; height: 1.5rem; border-radius: 50%;
    background: var(--gold); color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 700;
    opacity: 0; transition: opacity 0.2s ease;
  }
  .cat-card[aria-checked="true"] .cat-card__check { opacity: 1; }

  /* ──────── Discovery callout ──────── */
  .discovery { background: var(--wine-900); color: var(--cream-soft); }
  .discovery__inner { max-width: 620px; }
  .discovery__tag {
    font-size: var(--step--1); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 0.9rem;
  }
  .discovery__title {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.8rem, 1.3rem + 2.2vw, 2.8rem);
    line-height: 1.1; color: #f8f1e2; margin-bottom: 1rem;
  }
  .discovery__body {
    color: var(--cream-soft); opacity: 0.85;
    line-height: 1.72; font-size: var(--step-0);
    max-width: 55ch; margin-bottom: 1.8rem;
  }

  /* ──────── Order form section ──────── */
  .order-section { background: var(--cream); padding-top: 0; }

  .order {
    max-width: 740px; margin-inline: auto;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .order__title { font-size: var(--step-2); color: var(--wine-900); margin-bottom: 0.3rem; }

  .order__alert {
    margin-top: 1.2rem;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    background: rgba(201,168,106,0.16);
    border: 1px solid var(--gold);
    color: var(--wine-800);
    font-size: var(--step--1);
  }

  .order__group { margin-top: 1.8rem; }
  .order__label {
    font-size: var(--step--1); font-weight: 600;
    color: var(--wine-900); margin-bottom: 0.7rem;
    letter-spacing: 0.02em;
  }

  /* Bottle chips */
  .bottle-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .bottle-chip {
    min-width: 3.2rem; padding: 0.55em 0.9em;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-family: var(--font-mono); font-size: var(--step-0); font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .bottle-chip:hover { border-color: var(--gold-300); }
  .bottle-chip[aria-pressed="true"] {
    background: var(--wine-900); color: var(--cream-50);
    border-color: var(--wine-900);
  }

  /* Country field */
  .field { display: flex; flex-direction: column; }
  .field--wide { grid-column: 1 / -1; }
  .field label, .order__label {
    font-size: var(--step--1); font-weight: 600;
    color: var(--wine-900); margin-bottom: 0.4rem; letter-spacing: 0.02em;
  }
  .field input, .field select, .field textarea {
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line); border-radius: 8px;
    font-family: inherit; font-size: var(--step-0);
    color: var(--ink); background: var(--paper);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    resize: vertical;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,168,106,0.18);
  }
  .field--comment { margin-top: 1rem; }

  /* Price summary */
  .price-summary {
    margin-top: 1.8rem;
    padding: 1.2rem 1.4rem;
    background: rgba(62,15,24,0.04);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .price-row {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: var(--step-0);
    padding: 0.35rem 0;
  }
  .price-row + .price-row { border-top: 1px dashed var(--line); }
  .price-row--total {
    margin-top: 0.4rem; padding-top: 0.7rem;
    border-top: 1px solid var(--line) !important;
    font-weight: 600; font-size: var(--step-1);
  }
  .price-val { font-family: var(--font-mono); color: var(--wine-800); }
  .price-row--total .price-val { color: var(--wine-900); }

  /* Consultation banner */
  .consult-banner {
    margin-top: 1.4rem;
    padding: 1rem 1.2rem;
    background: rgba(201,168,106,0.1);
    border: 1px solid var(--gold-300);
    border-radius: 10px;
  }
  .consult-banner__text { font-size: var(--step--1); color: var(--wine-800); line-height: 1.55; }
  .consult-banner__btn { margin-top: 0.9rem; color: var(--wine-800); }

  /* Contact step */
  .contact-step {
    margin-top: 2rem; padding-top: 1.8rem;
    border-top: 1px solid var(--line);
  }
  .contact-step__title {
    font-size: var(--step-1); color: var(--wine-900); margin-bottom: 1rem;
  }
  .booking__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.1rem;
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .consent { display: flex; align-items: flex-start; gap: 0.6rem; margin: 1.4rem 0; }
  .consent input[type="checkbox"] {
    margin-top: 0.25rem; width: 1.05rem; height: 1.05rem;
    flex-shrink: 0; accent-color: var(--wine-800); cursor: pointer;
  }
  .consent span { font-size: var(--step--1); line-height: 1.5; color: var(--ink-soft); }
  .consent a { color: var(--wine-800); text-decoration: underline; text-underline-offset: 2px; }

  .customs-notice {
    padding: 0.9rem 1rem;
    background: rgba(62,15,24,0.05);
    border-left: 3px solid var(--gold-300);
    border-radius: 0 6px 6px 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: 1.4rem;
  }
  .customs-notice--ok {
    background: rgba(60,100,60,0.08);
    border-left-color: #4c8a4c;
    color: #2f5e2f;
  }

  #pay-btn[disabled] { opacity: 0.6; cursor: progress; transform: none; }

  .booking__error {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    background: rgba(160,60,60,0.1);
    border: 1px solid #a14444;
    color: #7a2e2e;
    font-size: var(--step--1);
  }

  /* ──────── FAQ ──────── */
  .cases-faq { background: var(--cream-50, #faf5ed); }
  .cases-faq__inner { max-width: 800px; }
  .cases-faq__title {
    font-family: var(--font-display); font-weight: 500;
    font-size: var(--step-2); color: var(--wine-900);
    margin-bottom: 2.4rem;
  }
  .faq-item { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-item h3 { font-size: var(--step-0); color: var(--wine-900); margin-bottom: 0.6rem; font-weight: 600; }
  .faq-item p { color: var(--ink-soft); line-height: 1.7; }
  .faq-item a { color: var(--wine-800); border-bottom: 1px solid var(--gold-300); padding-bottom: 1px; }
</style>

<script>
  import { calculateShipping } from "../data/shipping";
  import { getCaseCategory, CASE_CATEGORIES, BOTTLE_SIZES } from "../data/cases";

  type CheckoutResp = { url?: string; error?: string; consultation?: boolean; fields?: string[] };

  /* ── State ── */
  let selectedSlug: string = CASE_CATEGORIES[0].slug;
  let selectedBottles: number = BOTTLE_SIZES[1]; // default 12

  /* ── Element helpers ── */
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const catCards     = document.querySelectorAll<HTMLButtonElement>(".cat-card");
  const bottleChips  = document.querySelectorAll<HTMLButtonElement>(".bottle-chip");
  const countryEl   = $<HTMLSelectElement>("countryCode");
  const priceSummary = $("price-summary");
  const winePriceEl  = $("wine-price");
  const wineLabelEl  = $("wine-label");
  const shipPriceEl  = $("shipping-price");
  const grandTotalEl = $("grand-total");
  const consultBanner = $("consult-banner");
  const consultLink   = $<HTMLAnchorElement>("consult-link");
  const contactStep  = $("contact-step");
  const nameEl       = $<HTMLInputElement>("name");
  const emailEl      = $<HTMLInputElement>("email");
  const phoneEl      = $<HTMLInputElement>("phone");
  const commentEl    = $<HTMLTextAreaElement>("comment");
  const botEl        = $<HTMLInputElement>("botField");
  const consentEl    = $<HTMLInputElement>("consent");
  const payBtn       = $<HTMLButtonElement>("pay-btn");
  const payLabel     = $("pay-label");
  const formError    = $("form-error");

  // Per-language strings + language, rendered server-side on #order.
  const orderEl = $("order");
  const LANG = orderEl.dataset.lang === "pt" ? "pt" : "en";
  const L: Record<string, string> = JSON.parse(orderEl.dataset.i18n || "{}");

  function fmt(n: number) {
    const v = n.toFixed(2).replace(/\.00$/, "");
    return LANG === "pt" ? `${v.replace(".", ",")} €` : `€${v}`;
  }
  // Category name as shown on the card (already in the page language).
  function catLabel(slug: string, fallback: string) {
    return document.querySelector<HTMLElement>(`.cat-card[data-slug="${slug}"]`)?.dataset.name || fallback;
  }

  function updatePriceSummary() {
    const cat     = getCaseCategory(selectedSlug);
    const country = countryEl.value;

    if (!cat) return;

    const wineTotal = cat.pricePerBottle * selectedBottles;
    wineLabelEl.textContent = `${L.wines} (${selectedBottles} × ${fmt(cat.pricePerBottle)})`;
    winePriceEl.textContent = fmt(wineTotal);

    if (!country) {
      shipPriceEl.textContent = "—";
      grandTotalEl.textContent = "—";
      consultBanner.hidden = true;
      contactStep.hidden = true;
      return;
    }

    const shipping = calculateShipping(country, selectedBottles);

    if (shipping.kind === "price") {
      const grand = wineTotal + shipping.price;
      shipPriceEl.textContent = fmt(shipping.price);
      grandTotalEl.textContent = fmt(grand);
      consultBanner.hidden = true;
      contactStep.hidden = false;

      // Update consult mailto link for the edge case someone switches to consultation after
      updateConsultLink(catLabel(cat.slug, cat.name), selectedBottles, country);
    } else {
      shipPriceEl.textContent = L.consult;
      grandTotalEl.textContent = "—";
      consultBanner.hidden = false;
      contactStep.hidden = true;
      updateConsultLink(catLabel(cat.slug, cat.name), selectedBottles, country);
    }
  }

  function getCountryName(code: string) {
    return countryEl.options[countryEl.selectedIndex]?.text ?? code;
  }

  function updateConsultLink(catName: string, bottles: number, countryCode: string) {
    const countryName = getCountryName(countryCode);
    const subject = encodeURIComponent(
      `${L.quoteSubject} — ${catName}, ${bottles} ${L.bottles} ${L.to} ${countryName}`
    );
    consultLink.href = `mailto:${consultLink.href.split("?")[0].split("mailto:")[1]}?subject=${subject}`;
  }

  /* ── Category selection ── */
  catCards.forEach((card) => {
    card.addEventListener("click", () => {
      catCards.forEach((c) => c.setAttribute("aria-checked", "false"));
      card.setAttribute("aria-checked", "true");
      selectedSlug = card.dataset.slug || CASE_CATEGORIES[0].slug;
      updatePriceSummary();
    });
  });

  /* ── Bottle count selection ── */
  bottleChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      bottleChips.forEach((c) => c.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");
      selectedBottles = Number(chip.dataset.n);
      updatePriceSummary();
    });
  });

  /* ── Country change ── */
  countryEl.addEventListener("change", updatePriceSummary);

  /* ── Payment ── */
  function showError(msg: string) {
    formError.hidden = false;
    formError.textContent = msg;
  }

  async function pay() {
    formError.hidden = true;

    if (!nameEl.value.trim())                                  return showError(L.needName);
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value))    return showError(L.needEmail);
    if (phoneEl.value.replace(/[^\d]/g, "").length < 6)        return showError(L.needPhone);
    if (!consentEl.checked)                                     return showError(L.needConsent);

    payBtn.disabled = true;
    payLabel.textContent = L.redirecting;

    try {
      const res = await fetch("/api/create-case-checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          categorySlug: selectedSlug,
          bottles:      selectedBottles,
          countryCode:  countryEl.value,
          name:         nameEl.value.trim(),
          email:        emailEl.value.trim(),
          phone:        phoneEl.value.trim(),
          comment:      commentEl.value.trim(),
          consent:      consentEl.checked,
          botField:     botEl.value,
          lang:         LANG,
        }),
      });

      let body: CheckoutResp = {};
      try { body = await res.json(); } catch {}

      if (body.url) { window.location.href = body.url; return; }
      if (LANG === "en") showError(body.error || L.couldNotPay);
      else if (body.consultation) showError(L.consultation);
      else if (res.status === 429) showError(L.tooMany);
      else if (res.status === 400) showError(L.checkForm);
      else showError(L.couldNotPay);
    } catch {
      showError(L.network);
    } finally {
      payBtn.disabled = false;
      payLabel.textContent = L.pay;
    }
  }

  payBtn.addEventListener("click", pay);

  /* ── Initial state ── */
  // Pre-select first category card and 12 bottle chip
  catCards[0]?.setAttribute("aria-checked", "true");
  bottleChips.forEach((c) => c.setAttribute("aria-pressed", c.dataset.n === "12" ? "true" : "false"));
  updatePriceSummary();

  // Returning from a cancelled Stripe checkout
  if (new URLSearchParams(location.search).get("canceled") === "1") {
    $("canceled-note").hidden = false;
  }

  // Pre-scroll to order section from deep link
  if (new URLSearchParams(location.search).get("configure") === "1") {
    setTimeout(() => $("order")?.scrollIntoView({ behavior: "smooth", block: "start" }), 0);
  }
</script>
