---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ServicesBrowser from "../components/ServicesBrowser.astro";
import { langFromPath } from "../i18n/routes";

const lang = langFromPath(Astro.url.pathname);
const T = {
  en: {
    title: "Services · Tastings, Port & Wine Boxes",
    description:
      "Guided wine and Port tastings in Porto, led by Portugal's first Master of Port — and curated wine cases shipped worldwide. See every service.",
    eyebrow: "Services",
    heading: "What we pour, guide, and ship.",
    sub: "Every tasting and every box passes through the same hands — Portugal's first Master of Port.",
  },
  pt: {
    title: "Serviços · Provas, Vinho do Porto e Caixas",
    description:
      "Provas guiadas de vinho e de vinho do Porto no Porto, conduzidas pelo primeiro Master of Port de Portugal — e caixas de vinho enviadas para todo o mundo.",
    eyebrow: "Serviços",
    heading: "O que servimos, guiamos e enviamos.",
    sub: "Cada prova e cada caixa passam pelas mesmas mãos — as do primeiro Master of Port de Portugal.",
  },
};
const t = T[lang];
---

<Base title={t.title} description={t.description} headerSolid={true}>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} subtitle={t.sub} />

  <section class="section">
    <div class="container">
      <ServicesBrowser />
    </div>
  </section>
</Base>
