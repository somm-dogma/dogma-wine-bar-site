---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import { tastings } from "../data/tastings";
import TastingCard from "../components/TastingCard.astro";
import { langFromPath, r } from "../i18n/routes";
import { ui } from "../i18n/ui";

// Hero + section photography (Design handoff)
import heroImg from "../assets/images/hero-portrait.jpg";
import placeImg from "../assets/images/moment-cheers.jpg";
import cellarBg from "../assets/images/cellar-bg.jpg";
import vasiliiMop from "../assets/images/vasilii-mop.jpg";
import vasiliiPalmela from "../assets/images/vasilii-palmela.jpg";

// Moments gallery — 12 photos in Design's curated (non-sequential) order
import m01 from "../assets/images/moment-01.jpg";
import m02 from "../assets/images/moment-02.jpg";
import m03 from "../assets/images/moment-03.jpg";
import m04 from "../assets/images/moment-04.jpg";
import m05 from "../assets/images/moment-05.jpg";
import m06 from "../assets/images/moment-06.jpg";
import m07 from "../assets/images/moment-07.jpg";
import m08 from "../assets/images/moment-08.jpg";
import m09 from "../assets/images/moment-09.jpg";
import m10 from "../assets/images/moment-10.jpg";
import m11 from "../assets/images/moment-11.jpg";
import m12 from "../assets/images/moment-12.jpg";

// Credential medallions — finished PNGs, use as-is (object-fit: contain)
import credEscancoes from "../assets/images/cred-escancoes.png";
import credAsi from "../assets/images/cred-asi.png";
import credWset from "../assets/images/cred-wset.png";
import credIvv from "../assets/images/cred-ivv.png";

const lang = langFromPath(Astro.url.pathname);
const u = ui[lang];

// Recognition ledger — 5 entries. Certificate links only where the PDF exists
// in public/certificates/; the two Star Wine List entries point to the listing.
const SWL_URL =
  "https://starwinelist.com/wine-place/dogma-wine-bar?utm_source=badge&utm_content=large";

const T = {
  en: {
    overline: "Wine bar & tastings — Porto",
    headline: "The art of great winemakers, in a single glass.",
    subhead: "A wine paradise in the historic centre of Porto, guided by the first Master of Port in Portugal.",
    place: "Rua dos Caldeireiros 238 · 4050-139 Porto, Portugal",
    scroll: "Scroll to content",
    placeOver: "The place",
    placeTitle: "A wine paradise in the heart of Porto.",
    placeBody: "Since 2023, Dogma has become one of the city’s most talked-about wine bars — a place to slow down, taste widely, and let the terroir speak. A long communal table, a deep cellar, and the conviction that great wine is best understood in good company.",
    placeStat: "Established in the historic centre of Porto",
    placeAlt: "Friends toasting over a table of wine and petiscos at Dogma",
    credOver: "The credential",
    credTitle: "The first Master of Port in Portugal.",
    credBody: "The Master of Port is the highest distinction awarded for Port wine expertise. Vasilii Grebencea is the first in Portugal to hold it — and one of the country’s top three sommeliers. Every tasting at Dogma is led by someone who has reached the very top of his craft, and who pours it as a conversation rather than a lecture.",
    credCta: "Taste with a Master of Port",
    credAlt: "Vasilii Grebencea in focused preparation before the Master of Port evaluation",
    recOver: "Recognition",
    recTitle: "A young bar, already noticed.",
    viewCert: "View certificate",
    recAlt: "Vasilii Grebencea assessing a glass on stage at the National Sommelier Championship",
    recCap: "On stage · XIX Concurso Nacional de Escanções",
    affil: "Affiliations & credentials",
    propOver: "The tastings",
    propTitle: "We propose",
    propSub: "From a bright Vinho Verde region to the rarest Ports — six guided flights, each crafted with passion and dedication.",
    momOver: "Moments",
    momTitle: "Feel our vibe.",
    awards: [
      { year: "2024", dist: "Top 6 · Best Newcomer, worldwide", src: "Star Wine List of the Year", link: { href: SWL_URL, label: "View on Star Wine List" } },
      { year: "2024", dist: "Bronze · 3rd Best Sommelier in Portugal", src: "XIX Concurso Nacional de Escanções", cert: "/certificates/bronze-sommelier-2024.pdf" },
      { year: "2024 – 26", dist: "Red Star · three consecutive years — first in Portugal", src: "Star Wine List", link: { href: SWL_URL, label: "View on Star Wine List" } },
      { year: "2025", dist: "Travellers’ Choice · Top 10% worldwide", src: "Tripadvisor", cert: "/certificates/tripadvisor-travellers-choice-2025.pdf" },
      { year: "2025 – 28", dist: "Official Ambassador of Porto", src: "Sommelier Association of Portugal", cert: "/certificates/ambassador-porto-2025-2028.pdf" },
    ],
    medDesc: ["Portuguese Sommelier Association", "International Sommelier Association", "WSET", "Portuguese badge for venues with certified sommelier"],
    medAlt: [
      "Associação dos Escanções de Portugal — member seal",
      "ASI · Association de la Sommellerie Internationale — member seal",
      "WSET — Wine & Spirit Education Trust",
      "Estabelecimento com Escanção · Sommelier",
    ],
    moments: [
      "Vasilii, Master of Port, at Dogma",
      "Clams, bread and small plates from above, in black and white",
      "A guest enjoying a glass at the colourful banquette",
      "Opening a bottle for guests at the banquette",
      "Red wine poured against the patterned banquette",
      "The Dogma wine bar & tasting sign at number 238",
      "Friends gathered for an evening of wine and food",
      "Pouring wine at the bar, in black and white",
      "Red wine poured into two glasses at the table",
      "A couple toasting at the outdoor table on the cobbles",
      "A spread of petiscos — charcuterie, cheese and crudo with wine",
      "The dining room full of guests under warm pendant light",
    ],
  },
  pt: {
    overline: "Wine bar e provas — Porto",
    headline: "A arte dos grandes produtores, num só copo.",
    subhead: "Um paraíso do vinho no centro histórico do Porto, guiado pelo primeiro Master of Port de Portugal.",
    place: "Rua dos Caldeireiros 238 · 4050-139 Porto, Portugal",
    scroll: "Descer para o conteúdo",
    placeOver: "A casa",
    placeTitle: "Um paraíso do vinho no coração do Porto.",
    placeBody: "Desde 2023, o Dogma tornou-se um dos wine bars mais falados da cidade — um lugar para abrandar, provar sem pressa e deixar o terroir falar. Uma longa mesa partilhada, uma garrafeira profunda e a convicção de que o grande vinho se compreende melhor em boa companhia.",
    placeStat: "Fundado no centro histórico do Porto",
    placeAlt: "Amigos a brindar à mesa, entre vinho e petiscos, no Dogma",
    credOver: "A distinção",
    credTitle: "O primeiro Master of Port de Portugal.",
    credBody: "O Master of Port é a mais alta distinção atribuída ao conhecimento do vinho do Porto. Vasilii Grebencea é o primeiro em Portugal a recebê-la — e um dos três melhores escanções do país. Cada prova no Dogma é conduzida por alguém que chegou ao topo do seu ofício e que serve o vinho como uma conversa, não como uma aula.",
    credCta: "Provar com um Master of Port",
    credAlt: "Vasilii Grebencea em concentração antes da avaliação do Master of Port",
    recOver: "Reconhecimento",
    recTitle: "Um bar jovem, já reconhecido.",
    viewCert: "Ver certificado",
    recAlt: "Vasilii Grebencea a avaliar um copo em palco, no Concurso Nacional de Escanções",
    recCap: "Em palco · XIX Concurso Nacional de Escanções",
    affil: "Filiações e certificações",
    propOver: "As provas",
    propTitle: "Propomos",
    propSub: "Do luminoso Vinho Verde aos Portos mais raros — seis provas guiadas, cada uma preparada com paixão e dedicação.",
    momOver: "Momentos",
    momTitle: "Sinta o ambiente.",
    awards: [
      { year: "2024", dist: "Top 6 · Melhor estreia, a nível mundial", src: "Star Wine List of the Year", link: { href: SWL_URL, label: "Ver na Star Wine List" } },
      { year: "2024", dist: "Bronze · 3.º Melhor Escanção de Portugal", src: "XIX Concurso Nacional de Escanções", cert: "/certificates/bronze-sommelier-2024.pdf" },
      { year: "2024 – 26", dist: "Red Star · três anos consecutivos — o primeiro em Portugal", src: "Star Wine List", link: { href: SWL_URL, label: "Ver na Star Wine List" } },
      { year: "2025", dist: "Travellers’ Choice · Top 10% mundial", src: "Tripadvisor", cert: "/certificates/tripadvisor-travellers-choice-2025.pdf" },
      { year: "2025 – 28", dist: "Embaixador Oficial do Porto", src: "Associação dos Escanções de Portugal", cert: "/certificates/ambassador-porto-2025-2028.pdf" },
    ],
    medDesc: ["Associação dos Escanções de Portugal", "Associação Internacional de Escanções (ASI)", "WSET", "Selo de estabelecimento com escanção certificado"],
    medAlt: [
      "Associação dos Escanções de Portugal — selo de membro",
      "ASI · Association de la Sommellerie Internationale — selo de membro",
      "WSET — Wine & Spirit Education Trust",
      "Estabelecimento com Escanção · Sommelier",
    ],
    moments: [
      "Vasilii, Master of Port, no Dogma",
      "Amêijoas, pão e petiscos vistos de cima, a preto e branco",
      "Uma cliente a apreciar um copo no banco estofado colorido",
      "A abrir uma garrafa para clientes junto ao banco estofado",
      "Vinho tinto servido contra o padrão do banco estofado",
      "A placa do Dogma wine bar & tasting, no número 238",
      "Amigos reunidos para uma noite de vinho e comida",
      "A servir vinho ao balcão, a preto e branco",
      "Vinho tinto servido em dois copos à mesa",
      "Um casal a brindar na mesa exterior, sobre a calçada",
