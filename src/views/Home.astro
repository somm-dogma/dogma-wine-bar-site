const t = T[lang];

const medallionBase = [
  { src: credEscancoes, href: "https://escancoes.pt/" },
  { src: credAsi, href: "https://www.asi.info/" },
  { src: credWset, href: "https://www.wsetglobal.com/qualifications/wset-level-3-award-in-wines" },
  { src: credIvv, href: undefined },
];
const medallions = medallionBase.map((m, i) => ({ ...m, desc: t.medDesc[i], alt: t.medAlt[i] }));

const momentSrcs = [m02, m11, m04, m09, m06, m08, m12, m10, m03, m07, m05, m01];
const moments = momentSrcs.map((src, i) => ({ src, alt: t.moments[i] }));
const tastingsHref = r(lang, "tastings");
---

<Base>
  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="hero">
    <figure class="hero__photo" aria-hidden="true">
      <Image
        src={heroImg}
        alt=""
        widths={[800, 1300, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner">
      <p class="hero__overline" style="--d: 200ms">
        <span class="hero__rule"></span>{t.overline}
      </p>
      <h1 class="hero__headline" style="--d: 320ms">{t.headline}</h1>
      <p class="hero__subhead" style="--d: 460ms">{t.subhead}</p>
      <div class="hero__cta" style="--d: 600ms">
        <a class="btn btn--cream" href={tastingsHref}>{u.bookTasting}</a>
        <a class="btn btn--ghost" href={site.booking.table} target="_blank" rel="noopener">{u.bookTable}</a>
        <a class="btn btn--ghost" href={r(lang, "menu")}>{u.menu}</a>
      </div>
      <p class="hero__place" style="--d: 700ms">{t.place}</p>
    </div>

    <a class="hero__scroll" href="#place" aria-label={t.scroll}><span></span></a>
  </section>

  <!-- ───────────────────────── THE PLACE ───────────────────────── -->
  <section class="section place" id="place">
    <div class="wrap place__inner">
      <div class="place__text" data-reveal="left">
        <p class="overline overline--ink"><span class="overline__rule"></span>{t.placeOver}</p>
        <h2 class="place__title">{t.placeTitle}</h2>
        <p class="place__body">{t.placeBody}</p>
        <p class="place__stat">
          <span class="place__year">2023</span>
          <span class="place__divider" aria-hidden="true"></span>
          <span class="place__statlabel">{t.placeStat}</span>
        </p>
      </div>
      <figure class="place__media" data-reveal="right">
        <Image
          src={placeImg}
          alt={t.placeAlt}
          widths={[420, 760, 1000]}
          sizes="(max-width: 860px) 100vw, 44vw"
        />
      </figure>
    </div>
  </section>

  <!-- ───────────────────── THE CREDENTIAL (dark band) ───────────────────── -->
  <section class="section credential">
    <Image
      src={cellarBg}
      alt=""
      class="credential__bg"
      aria-hidden="true"
      widths={[768, 1280, 1800]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="credential__scrim" aria-hidden="true"></div>
    <div class="wrap credential__inner">
      <figure class="credential__media" data-reveal="left">
        <Image
          src={vasiliiMop}
          alt={t.credAlt}
          widths={[420, 720, 980]}
          sizes="(max-width: 860px) 100vw, 40vw"
        />
      </figure>
      <div class="credential__text" data-reveal="right">
        <p class="overline"><span class="overline__rule overline__rule--brass"></span>{t.credOver}</p>
        <h2 class="credential__title">{t.credTitle}</h2>
        <p class="credential__body">{t.credBody}</p>
        <a class="btn btn--cream" href={`${tastingsHref}?tasting=dreamy-ports`}>{t.credCta}</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── RECOGNITION ───────────────────────── -->
  <section class="section recognition" id="recognition">
    <div class="wrap">
      <header class="recognition__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>{t.recOver}</p>
        <h2 class="section__title">{t.recTitle}</h2>
      </header>

      <div class="recognition__layout">
        <ol class="awards" role="list">
          {t.awards.map((a) => (
            <li class="award" data-reveal>
              <span class="award__year">{a.year}</span>
              <span class="award__detail">
                <span class="award__dist">{a.dist}</span>
                <span class="award__src">{a.src}</span>
                {a.cert && (
                  <a class="award__link" href={a.cert} target="_blank" rel="noopener"
                     aria-label={`${t.viewCert} — ${a.dist}`}>{t.viewCert} →</a>
                )}
                {a.link && (
                  <a class="award__link" href={a.link.href} target="_blank" rel="noopener"
                     aria-label={`${a.link.label} — ${a.dist}`}>{a.link.label} →</a>
                )}
              </span>
            </li>
          ))}
        </ol>

        <figure class="recognition__photo" data-reveal="right">
          <div class="recognition__frame">
            <Image
              src={vasiliiPalmela}
              alt={t.recAlt}
              widths={[420, 760, 1100]}
              sizes="(max-width: 860px) 100vw, 36vw"
            />
          </div>
          <figcaption class="recognition__cap">{t.recCap}</figcaption>
        </figure>
      </div>

      <div class="affiliations" data-reveal>
        <p class="overline overline--ink affiliations__label">{t.affil}</p>
        <ul class="affiliations__row" role="list">
          {medallions.map((m) => (
            <li class="cred">
              {m.href ? (
                <a class="medallion" href={m.href} target="_blank" rel="noopener noreferrer" aria-label={m.desc}>
                  <Image src={m.src} alt={m.alt} widths={[160, 320]} sizes="148px" loading="lazy" />
                </a>
              ) : (
                <span class="medallion">
                  <Image src={m.src} alt={m.alt} widths={[160, 320]} sizes="148px" loading="lazy" />
                </span>
              )}
              <p class="cred__desc">{m.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────────────────── WE PROPOSE (the tastings) ───────────────────── -->
  <section class="section propose" id="tastings">
    <div class="wrap">
      <header class="propose__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>{t.propOver}</p>
        <h2 class="propose__title">{t.propTitle}</h2>
        <p class="propose__sub">{t.propSub}</p>
      </header>
      <div class="propose__grid" data-reveal>
        {tastings.map((tt) => <TastingCard tasting={tt} />)}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── MOMENTS ───────────────────────── -->
  <section class="section moments" id="moments">
    <div class="wrap wrap--gallery">
      <header class="moments__head" data-reveal>
        <p class="overline overline--ink"><span class="overline__rule"></span>{t.momOver}</p>
        <h2 class="section__title">{t.momTitle}</h2>
      </header>
      <div class="moments__wall">
        {moments.map((m) => (
          <figure class="mw__item">
            <Image
              src={m.src}
              alt={m.alt}
              widths={[320, 540, 760]}
              sizes="(max-width: 680px) 48vw, (max-width: 1100px) 32vw, 24vw"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

</Base>

<script>
  // Scroll reveals — IntersectionObserver, reduced-motion safe, with a
  // failsafe that reveals everything if IO never fires.
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (prefersReduced || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -7% 0px" }
    );
    items.forEach((el) => observer.observe(el));
    // failsafe
    window.setTimeout(() => items.forEach((el) => el.classList.add("is-visible")), 2800);
  }
</script>

<style>
  /* ───────── shared layout helpers ───────── */
  .wrap {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }
  .wrap--gallery { max-width: var(--container-gallery); }
  .section { padding-block: clamp(88px, 13vw, 168px); }
  .section__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin-top: 0.3em;
    text-wrap: balance;
  }

  /* Overlines — brass rule + label */
  .overline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .overline--ink { color: var(--brass-mid); }
  .overline--center { justify-content: center; color: var(--brass); }
  .overline__rule { width: 34px; height: 1px; background: currentColor; opacity: 0.85; }
  .overline__rule--brass { background: var(--brass); opacity: 0.9; }

  /* ───────── HERO ───────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    overflow: hidden;
    background: var(--hero-base);
    color: var(--cream-50);
    padding: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)) clamp(20px, 4vw, 40px) clamp(3.5rem, 8vw, 6rem);
  }
  .hero__photo { position: absolute; inset: 0; z-index: 0; margin: 0; }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: kenburns 7200ms var(--ease-out) both;
  }
  @keyframes kenburns {
    from { transform: scale(1.09); }
    to { transform: scale(1); }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(20, 12, 8, 0.6) 0%,
        rgba(20, 12, 8, 0.28) 28%,
        rgba(20, 12, 8, 0.42) 58%,
        rgba(20, 12, 8, 0.78) 82%,
        rgba(20, 12, 8, 0.94) 100%
      ),
      radial-gradient(120% 80% at 50% 100%, rgba(20, 12, 8, 0.5), transparent 60%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 1.7rem);
    max-width: 820px;
  }
  .hero__overline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #e8d9be;
  }
  .hero__rule { width: 38px; height: 1px; background: var(--brass); }
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, 5.8vw, 84px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: #f8f1e2;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero__subhead {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.7;
    color: #e4d8c4;
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 0.4rem;
  }
  .hero__place {
    margin-top: clamp(0.8rem, 2vw, 1.4rem);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: #f8f1e2;
  }
  /* staggered entrance */
  .hero__overline, .hero__headline, .hero__subhead, .hero__cta, .hero__place {
    opacity: 0;
    animation: heroRise 900ms var(--ease-reveal) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: none; }
  }
  .hero__scroll {
    position: absolute;
    z-index: 2;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 54px;
    background: linear-gradient(to bottom, transparent, var(--brass));
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--cream-50));
    animation: scrollPulse 2400ms ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  /* ───────── THE PLACE ───────── */
  .place { background: var(--cream); }
  .place__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
