---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import { langFromPath, r } from "../i18n/routes";

const lang = langFromPath(Astro.url.pathname);
const T = {
  en: {
    title: "Booking confirmed", description: "Your tasting at Dogma Wine Bar is confirmed.",
    eyebrow: "Payment received", heading: "Your tasting is booked.",
    lead: "Thank you — your payment went through and your tasting is confirmed. A confirmation email is on its way with the details. We can’t wait to pour for you.",
    metaA: "Need to change anything, or have a question? Call us on", metaB: "or email",
    home: "Back to home", menu: "View the menu",
  },
  pt: {
    title: "Reserva confirmada", description: "A sua prova no Dogma Wine Bar está confirmada.",
    eyebrow: "Pagamento recebido", heading: "A sua prova está reservada.",
    lead: "Obrigado — o pagamento foi concluído e a sua prova está confirmada. Vai receber um email de confirmação com todos os detalhes. Até breve, à nossa mesa.",
    metaA: "Precisa de alterar alguma coisa ou tem alguma dúvida? Ligue-nos para o", metaB: "ou escreva para",
    home: "Voltar ao início", menu: "Ver a carta",
  },
};
const t = T[lang];
---

<Base title={t.title} description={t.description} headerSolid noindex>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} />

  <section class="section confirmed">
    <div class="container confirmed__inner">
      <p class="lead">{t.lead}</p>
      <p class="confirmed__meta">
        {t.metaA} <a href={site.contact.phoneHref}>{site.contact.phone}</a> {t.metaB}
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </p>
      <div class="confirmed__cta">
        <a class="btn btn--primary" href={r(lang, "home")}>{t.home}</a>
        <a class="btn btn--ghost" href={r(lang, "menu")}>{t.menu}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .confirmed { background: var(--cream-50); }
  .confirmed__inner { max-width: 640px; }
  .confirmed .lead { color: var(--ink); }
  .confirmed__meta { margin-top: 1.2rem; color: var(--ink-soft); }
  .confirmed__meta a { color: var(--wine-800); border-bottom: 1px solid var(--gold-300); padding-bottom: 1px; }
  .confirmed__meta a:hover { color: var(--gold); }
  .confirmed__cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }
  .confirmed__cta .btn--ghost { color: var(--wine-800); }
</style>

<script>
  // If Stripe didn't send a session_id, this page was reached directly — keep the
  // message friendly but nudge them to the booking page.
  if (!new URLSearchParams(location.search).get("session_id")) {
    // no-op: the static message still reads fine without it.
  }
</script>
